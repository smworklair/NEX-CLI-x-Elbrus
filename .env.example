# Скопировать в .env (файл в .gitignore, не коммитится) и вписать ключи.
# Без этого файла и без NEX_API_KEY агент работает офлайн: честно говорит,
# что модель недоступна, и отвечает по уже посчитанным числам (vliw.core).
#
# Нужен только ОДИН ключ — тот провайдер, которым пользуетесь.
# Провайдер выбирается NEX_PROVIDER (по умолчанию mistral), см. vliw/agent/llm.py.

MISTRAL_API_KEY=
GEMINI_API_KEY=
