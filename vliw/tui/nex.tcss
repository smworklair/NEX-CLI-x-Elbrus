/* ------------------------------------------------------------------------
   NEX — UI styling.

   Colors come from the project palette (vliw/ui/themes/*.json) via $nex-*
   variables: the same theme styles both line output and this screen. This
   stylesheet defines only layout and surface hierarchy.

   Surfaces: canvas < panel < raised (active).
   Each mode sets its own accent ($primary) via the app theme.
   ------------------------------------------------------------------------ */

Screen {
    /* Layer for typing hints: floats above the layout without reserving space. */
    layers: base overlay;
    background: $nex-canvas;
    color: $nex-text;
}

/* --- scrollbars --------------------------------------------------------- */
/* Size 1 across the entire UI. Textual's default (2 cells) stuck out next to
   the editor and containers, looking like a broken layout rather than a
   position indicator. Bar colors come from the theme ($scrollbar-*): panel
   background, slightly brighter thumb so it never competes with content. */
TextArea, VerticalScroll, OptionList, DataTable, RichLog, ItemGrid {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

/* --- inputs and borders without thin block glyphs ----------------------- */
/* By default Input draws a `tall` border using ▊ ▔ ▎ ▁, and Textual scrollbars
   use ▁▂▃…; in fonts missing those glyphs every cell becomes a replacement box.
   `solid` uses standard single-line box drawing (┌─┐│└┘) present in all console
   fonts. Same look, without rare glyphs. */
Input {
    border: solid $nex-line;
}
Input:focus {
    border: solid $primary;
}

/* --- mode header -------------------------------------------------------- */
/* height auto instead of 1: a second line may show dormant mode facts.
   Without facts the second line is hidden by code, keeping the header 1 row. */

TopBar {
    dock: top;
    height: auto;
    width: 100%;
    padding: 0 2;
    background: $nex-shadow;
}

#topbar-line { height: 1; width: 100%; }

/* Second line — LAB pilot: one short fact per dormant mode (CORE/AGENT/CODE);
   clicking opens that mode. */

#topbar-sleep {
    display: none;
    height: 1;
    width: 100%;
}

#topbar-sleep.on { display: block; }

.sleep-sep { width: auto; height: 1; color: $nex-faint; }

.sleep-chip {
    width: auto;
    height: 1;
    color: $nex-dim;
}

.sleep-chip:hover {
    background: $primary 25%;
    color: $nex-title;
    text-style: bold;
}

/* --- input dock --------------------------------------------------------- */
/* The input line is a terminal prompt, not a card widget: one row of text on
   the canvas separated by a top hairline, with no full-width gray bar or empty
   padding rows that compete with panel borders above it. */

#dock {
    dock: bottom;
    height: auto;
    width: 100%;
    background: $nex-canvas;
}

PromptBar {
    height: auto;
    width: 100%;
}

/* 2 rows: text line and top hairline. Focus is shown by the line itself:
   the hairline intensifies to the mode accent and text brightens slightly.
   No background fill — a $nex-raised bar looked pasted onto the screen. */
#prompt-field {
    height: 2;
    width: 100%;
    margin: 0;
    padding: 0 1;
    background: transparent;
    border-top: solid $nex-line 30%;
}

#prompt-field:focus-within {
    background: transparent;
    border-top: solid $primary 55%;
}

/* Single-row children. Prompt mark is a 1-cell ">" chevron plus space;
   a full "nex" badge on the shared bar was visual noise. */

#prompt-mark {
    width: 2;
    height: 1;
    content-align: left middle;
}

#prompt-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}

#prompt-input > .input--placeholder {
    color: $nex-faint;
    text-style: none;
}

#prompt-side {
    width: auto;
    height: 1;
    padding: 0 1;
    content-align: right middle;
}

HintBar {
    height: 1;
    width: 100%;
    padding: 0 2;
    background: $nex-shadow;
}

/* --- command palette ---------------------------------------------------- */

Palette {
    max-height: 12;
    height: auto;
    width: 100%;
    background: $nex-panel;
    border: none;
    border-left: thick $primary;
    padding: 0;
    scrollbar-size-vertical: 1;
}

Palette > .option-list--option-highlighted {
    background: $primary 25%;
    color: $nex-title;
    text-style: bold;
}

/* --- panels ------------------------------------------------------------- */

/*
   WINDOW — a single-line header and content beneath it. No boxes or rounded
   borders.

   Previously each panel was a rounded-border box with an all-caps border title,
   spending 14 rows of height on borders alone across 6-7 panels and clashing
   with CODE's flat windows whenever double-clicking a tab.

   The header is a `.panel-head` widget on the first row (see PanelHead in
   widgets.py). Adjacent columns are separated by a container hairline, and
   stacked windows are already separated by their header strips.
*/
Panel {
    border: none;
    background: transparent;
    padding: 0;
    height: 1fr;
}

/* Content indents one cell from the window edge, matching CODE dock tabs.
   The header is excluded because it has its own padding and class specificity
   beats type specificity in Textual CSS. */
Panel > * { padding-left: 1; }

/* Hairline between columns where two windows meet. No need to box all four
   sides: screen edges need no border and stacked windows are separated by
   their header bars. */
#mind-right, #lab-right, #core-right { border-left: solid $nex-line; }

/* Window header — single-row bar. Background fills under padding, so the bar
   spans the full width while text stays inset by one cell. */
.panel-head {
    height: 1;
    width: 100%;
    background: $nex-panel;
    text-style: bold;
    padding: 0 1;
}

/* Active window is indicated by its header rather than a colored border:
   borders are gone, but focus must remain clear. */
Panel:focus-within > .panel-head { background: $nex-raised; }

/* --- panel toolbar ------------------------------------------------------ */
/* The toolbar is always the first child of a panel and always visible, not
   only when maximized: run, oracle rewrite, filters, and navigation are core
   actions. Maximizing adds space and columns rather than hiding basic buttons. */

PanelToolbar {
    display: block;
    /* auto instead of 1: extra chips wrap onto a second row (see PanelToolbar);
   a fixed 1 would clip wrapped chips. */
    height: auto;
    width: 100%;
    /* Content-sized tracks instead of 1fr so columns do not stretch full-width
   and leave wide gaps between chips (visible in the wide GIT panel). */
    grid-columns: auto;
}

/* Chip margin lives inside grid tracks, which previously clipped chips by one
   cell. Spacing is preserved via 0 1 padding on each chip (two blank cells
   between neighbors). Scoped to toolbar only; DockTabs keeps its margins. */
PanelToolbar Tool { margin-right: 0; }

/* Narrow screen (80 cols): duplicate chips hide so the toolbar stays 1 row.
   Otherwise wrapping added unbudgeted rows to the right column and pushed
   MACHINE below the fold. Keyboard shortcuts remain unchanged. */
ModeScreen.tight .tb-spare { display: none; }

Tool {
    height: 1;
    width: auto;
    padding: 0 1;
    margin-right: 1;
    background: $nex-raised;
    color: $nex-dim;
}

Tool:hover {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

Tool.tool-on {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

/* A maximized panel fills all space between the header and input dock
   regardless of its normal height. Because many panels set explicit heights by
   id (#p-console: 10, #p-detail: 9, #p-seen: 12), `!important` overrides id
   specificity. `1fr` (not `100%`) keeps the header, input line, and hints
   visible at all times. */
Panel.-maximized {
    height: 1fr !important;
    max-height: 100% !important;
    min-height: 0 !important;
    width: 100% !important;
}

/* Maximized panel with chat yields one-third width to chat, staying on the
   left so you read the panel while asking about it. */
/* 1fr instead of percentages: chat docks on the right and the panel fills the
   exact remainder without leaving margins. */
Panel.-maximized.with-chat {
    width: 1fr !important;
}

/* No layer: a layer floats over the layout and overlaps the panel. Regular
   docking reserves its share of width cleanly. */
PanelChat {
    width: 34%;
    height: 100%;
    background: $nex-panel;
    border: solid $primary;
    border-title-align: left;
    padding: 0 1;
}

PanelChat.right { dock: right; }

/* For panels with their own input line, chat docks on the left so two input
   fields do not sit side by side on the right. */
PanelChat.left { dock: left; }

#pchat-log {
    height: 1fr;
    overflow-y: auto;
}

#pchat-input {
    dock: bottom;
    border: none;
    border-top: solid $nex-line;
    background: transparent;
    height: 2;
}

Console {
    background: transparent;
    scrollbar-size-vertical: 1;
    padding: 0;
}

/* --- CORE: interpreter workbench ---------------------------------------- */

#core-body {
    height: 1fr;
    width: 100%;
}

#core-left {
    width: 1fr;
    height: 100%;
}

#core-right {
    width: 42;
    height: 100%;
}

#p-tape { height: 1fr; }

#p-kernels {
    height: 4;
    padding: 0 1;
}

#kernel-chips, #verb-chips {
    height: 1;
    width: 100%;
}

.chip-label {
    width: 6;
    height: 1;
    color: $nex-faint;
}

#p-names { height: 1fr; min-height: 6; }
#p-mem   { height: 7; }
#p-prog  { height: 2fr; min-height: 8; }

/* TAPE list is the primary view: history of user lines with each result.
   Rows are clickable (linked to PROGRAM); slash-command reports live in the
   console below the list while fresh. */
#tape-sheet {
    height: 1fr;
    width: 100%;
    scrollbar-size-vertical: 1;
}

.tape-row {
    height: auto;
    width: 100%;
    padding: 0 1;
}

.tape-row:hover { background: $nex-raised; }
.tape-row.on { background: $primary 18%; }

.tape-report { padding: 0 1 0 3; }

.tape-empty { height: auto; width: 100%; padding: 0 1; }

#p-tape #console {
    height: 8;
    scrollbar-size-vertical: 1;
    border-top: solid $nex-line 30%;
}

.chip {
    height: 1;
    width: auto;
    padding: 0 1;
    margin-right: 1;
    background: $nex-raised;
    color: $nex-dim;
}

.chip:hover {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

.chip-kernel { color: $nex-accent-soft; }

/* --- LAB: interactive schedule ------------------------------------------ */
/* Schedule is the main block on screen, so surrounding panels stay compact:
   BLOCK is a chip strip, WHY HERE and output are narrow panes, and the grid
   (#p-grid, 1fr) takes all remaining height. */

#lab-body { height: 1fr; width: 100%; }
#lab-left { width: 1fr; height: 100%; }
#lab-right { width: 46; height: 100%; }

#p-scen {
    height: auto;
    max-height: 5;
    padding: 0 1;
}

#view-chips { height: auto; width: auto; }
#scenario-chips { height: auto; width: 100%; grid-gutter: 0; }

/* Row above the grid: view switcher on the left, live counters on the right. */
#grid-head { height: 1; width: 100%; }
#grid-hud {
    width: 1fr;
    height: 1;
    content-align: right middle;
    color: $nex-dim;
}

/* Maximized grid: grid on the left, inspector on the right. Border and padding
   frame the column as a distinct pane (CURSOR / FINDING / CHANNELS / KEYS). */
#grid-main { height: 1fr; width: 100%; }

#grid-side {
    display: none;
    width: 44;
    height: 100%;
    border-left: solid $nex-line;
    padding: 0 0 0 1;
    background: $nex-panel;
}

Panel.-maximized #grid-side { display: block; }

.chip-view { color: $nex-dim; }

.chip-on {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

.chip-scen {
    width: 1fr;
    /* Margin lives inside grid tracks: at min_column_width 13 a chip had 12 cells,
   clipping `divpressure` (11 chars + 2 padding = 13) to `divpressur`. Adjacent
   0 1 padding already gives a 2-cell gap. Same fix as PanelToolbar above. */
    margin-right: 0;
    background: transparent;
    color: $nex-dim;
}

#p-grid { height: 1fr; min-height: 8; }

/* GIT taller than before (7): a 2-line strip looked truncated. Height also
   accommodates the embedded command line. */
#p-console { height: 12; }

/* Command line inside GIT — panel-colored chip that reveals a muted accent
   border and highlight on focus. Uses the same PromptBar: `/` palette,
   history, and busy indicator. */
#p-console #prompt { height: auto; width: 100%; }

/* Input line inside a panel belongs to the panel rather than floating as a
   nested box. A top hairline separates it cleanly and brightens on focus. */
/* Same terminal prompt line in GIT as in the dock: single row, top hairline,
   accented hairline on focus. */
#p-console #prompt-field {
    height: 2;
    margin: 0;
    padding: 0 1;
    background: transparent;
    border: none;
    border-top: solid $nex-line 30%;
}

#p-console #prompt-field:focus-within {
    background: transparent;
    border: none;
    border-top: solid $primary 55%;
}

#p-console #prompt-side { padding: 0 1; }

/* Placeholder slightly brighter than faint: it invites typing rather than
   looking like skippable output. */
#p-console #prompt-input > .input--placeholder {
    color: $nex-dim;
}

/* `/` palette inside the panel has far less height than the dock: cap its
   height so it scrolls instead of pushing the input line off-screen. */
#p-console Palette {
    max-height: 5;
    scrollbar-size-vertical: 1;
}

#grid {
    background: transparent;
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

/* Bridge under the grid to maximized DIAGNOSIS. Hidden by default so it does
   not steal a row from the schedule in normal view; shown by code only when
   the grid is maximized. */
#grid-link {
    display: none;
    height: 1;
    padding: 0 1;
}

#grid-link.on { display: block; }

/* --- DIAGNOSIS: full findings list when maximized ----------------------- */

#diag-filter {
    height: auto;
    width: 100%;
    /* Keep a gap between the filter bar and findings list so their borders do not
   merge into one bar (matches #machine-filter-row). */
    margin-bottom: 1;
}

.diag-sev {
    width: auto;
}

.finding-row {
    height: auto;
    width: 100%;
    margin-bottom: 1;
    padding: 0 1;
}

.finding-row:hover {
    background: $nex-raised;
}

/* Finding for the cell under the cursor: left accent bar (like a blockquote)
   instead of a full-width fill that competes with the panel border. */
.finding-row.here {
    border-left: thick $primary;
    padding-left: 1;
}

#diag-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#grid > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}

#grid > .datatable--cursor {
    background: $primary 35%;
    color: $nex-title;
}

#grid > .datatable--hover {
    background: $nex-raised;
}

/* DIAGNOSIS collapses to a summary line in normal view (details duplicate the
   grid); double-click or press `d` from the grid for the full list. */
/* Right column must fit completely: NUMBERS and WHY HERE size to content with
   caps; long explanations and AI answers scroll inside rather than pushing
   MACHINE below the fold. DIAGNOSIS takes the remainder; maximize lifts caps. */
/* LAB right column shares height instead of growing unbounded. `#p-detail`
   takes 1fr with its own VerticalScroll so lower panels keep their sizes. */
#p-numbers  { height: auto; max-height: 12; }
/* NEURAL NETS: scrolls internally; cap grows only on tall terminals (.roomy). */
#p-ai       { height: auto; min-height: 4; max-height: 7; }
#ai-scroll  { height: auto; max-height: 100%; scrollbar-size-vertical: 1; }
ModeScreen.roomy #p-ai { max-height: 17; }
#p-detail   { height: 1fr; min-height: 6; }
#p-diag     { height: auto; min-height: 4; max-height: 8; }
#p-machine  { height: auto; min-height: 6; max-height: 9; }

/* Short terminal: tighten lower panels; detail shrinks naturally as 1fr. */
ModeScreen.low #p-numbers { max-height: 8; }
ModeScreen.low #p-ai      { min-height: 3; max-height: 5; }
ModeScreen.low #p-diag    { min-height: 3; max-height: 5; }
ModeScreen.low #p-machine { min-height: 4; max-height: 6; }
ModeScreen.low #p-detail  { min-height: 4; }

ModeScreen.very-low #p-numbers { max-height: 6; }
ModeScreen.very-low #p-ai      { min-height: 3; max-height: 4; }
ModeScreen.very-low #p-diag    { min-height: 3; max-height: 4; }
ModeScreen.very-low #p-machine { min-height: 3; max-height: 4; }

/* MACHINE summary has no internal scroll; cap height to fit the pane on short
   terminals (overflowing lines are accessible via `/model`). */
#machine { height: auto; max-height: 100%; overflow-y: hidden; }
ModeScreen.very-low #p-detail  { min-height: 3; }

#detail-scroll {
    height: auto;
    max-height: 12;
    scrollbar-size-vertical: 1;
}

/* Maximized detail view uses the full panel height instead of 12 rows. */
#p-detail.-maximized #detail-scroll { height: 1fr; max-height: 100%; }

/* --- AGENT: dialog with visible grounding ------------------------------- */

#mind-body { height: 1fr; width: 100%; }
#mind-left { width: 1fr; height: 100%; }
#mind-right { width: 42; height: 100%; }

#p-chat { height: 1fr; }

/* Maximized DIALOG: question history on the left, transcript on the right.
   Toggled by code on maximize so rendering depends on mode, not size. */
#chat-body { width: 100%; height: 100%; }

#chat-hist-col {
    display: none;
    width: 46;
    height: 100%;
    border-right: solid $nex-line 35%;
    padding-right: 1;
}

#chat-hist {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

.hist-item {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.hist-item:hover { background: $nex-raised; }
#p-questions { height: auto; max-height: 6; padding: 0 1; }
#question-chips { height: auto; width: 100%; }

.chip-question {
    width: 1fr;
    margin-right: 1;
    background: transparent;
    color: $nex-mind-soft;
}

#chat {
    height: 100%;
    width: 1fr;
    scrollbar-size-vertical: 1;
}

.msg-you {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.msg-mark { height: 1; width: 100%; }

.msg-nex {
    height: auto;
    width: 100%;
    padding-left: 2;
    margin-bottom: 1;
}

.msg-note {
    height: auto;
    width: 100%;
    color: $nex-dim;
    margin-bottom: 1;
}

/* AGENT right column: HQ is primary (1fr), TRACE takes leftovers, CONNECTION
   and AGENT CONTEXT are compact blocks. Minimum heights must fit in 24 rows;
   extra detail appears only when maximized. */
#p-hq    { height: 1fr; min-height: 8; }
#p-model  { height: auto; max-height: 12; }
#p-seen   { height: 7; }
#p-trace  { height: 1fr; min-height: 5; }

/* Clip agent summary if taller than the pane on short terminals (same as
   #machine in LAB). */
#seen { height: auto; max-height: 100%; overflow-y: hidden; }

/* Compact CONNECTION: providers plus API key row with button. */
#model-mini { height: auto; }
#model-provs-mini { height: auto; }
#model-mini-row { height: 3; margin-top: 1; }
#model-key-mini { width: 1fr; height: 3; }
#model-go { width: auto; height: 3; margin-left: 1; }

/* Maximized CONNECTION: sections and height-capped lists. */
#model-wide { height: 1fr; }
#model-wide Input { height: 3; margin-bottom: 1; }
#model-provs, #model-presets { height: auto; }
#model-status, #model-note, #model-local-help, #model-filter-help,
#model-sec-prov, #model-sec-key, #model-sec-local, #model-sec-list,
#model-sec-manual {
    height: auto;
    margin: 1 0;
}
#model-list { height: auto; max-height: 16; scrollbar-size-vertical: 1; }
#model-folder, #model-manual, #model-url { height: 3; }
#p-model.-maximized #model-list { max-height: 100%; height: 1fr; }

/* HQ: task is always visible; details appear only when maximized. */
#hq-mini { height: auto; }
#hq-task { height: 3; margin-top: 1; }
#hq-wide { height: 1fr; }
#hq-wide Input { height: 3; margin-bottom: 1; }
#hq-conns, #hq-areas { height: auto; }
#hq-area-desc, #hq-note, #hq-sec-conn, #hq-sec-area, #hq-sec-script,
#hq-sec-list {
    height: auto;
    margin: 1 0;
}
#hq-actions { height: auto; }
#hq-list { height: auto; max-height: 24; scrollbar-size-vertical: 1; }
#p-hq.-maximized #hq-list { max-height: 100%; height: 1fr; }

/* --- narrow window ------------------------------------------------------ */

ModeScreen.narrow #core-right,
ModeScreen.narrow #lab-right { width: 40; }
ModeScreen.narrow #mind-right { width: 38; }

ModeScreen.narrow #p-console { height: 11; }
ModeScreen.narrow #p-seen { height: 9; }

ModeScreen.tight #core-right,
ModeScreen.tight #lab-right,
ModeScreen.tight #mind-right { width: 34; }

ModeScreen.tight #p-kernels,
ModeScreen.tight #p-scen,
ModeScreen.tight #p-questions { display: none; }

ModeScreen.tight #p-console { height: 8; }

/* --- AGENT on short terminals (placed after width rules so equal specificity
   resolves in favor of height constraints) ------------------------------- */

/* Short: HQ shrinks to content (no fr reserve); AGENT CONTEXT tightens first,
   then TRACE. */
ModeScreen.low #p-hq    { height: auto; }
ModeScreen.low #p-seen  { height: 5; }
ModeScreen.low #p-trace { min-height: 3; }

/* Very short: hide AGENT CONTEXT and API buttons; the same facts remain via
   TAB in maximized HQ, and the key input stays below. */
ModeScreen.very-low #p-seen         { display: none; }
ModeScreen.very-low #p-trace        { min-height: 3; }
ModeScreen.very-low #p-hq           { min-height: 7; }
ModeScreen.very-low #model-provs-mini { display: none; }

/* --- CODE: editor, bottom dock, status bar ------------------------------ */
/*
   Single workspace with docked panes, IDE-style:

       mode header                                   1
       file tab strip                                1
       EDITOR                                        remainder
       ───────── hairline ─────────
       tabs: schedule | inspect | issues | output
       tab content                                   ~one third
       status bar                                    1
       key hints                                     1

   One bottom pane instead of two so the editor remains the largest region and
   the status bar stays anchored at the very bottom. No extra box borders —
   only the hairline above the dock and the status bar backing.
*/

#code-head {
    height: 1;
    width: 100%;
    background: $nex-shadow;
}


#code-body { height: 1fr; width: 100%; }

/* Left examples/repo catalog. Closed by default (^B toggles) so it does not
   permanently consume 20 columns. Separated by a right hairline. */
#code-side {
    display: none;
    width: 22;
    height: 100%;
    border-right: solid $nex-line;
}

/* File list beneath the header: list scrolls while header stays fixed. */
#code-side-list {
    height: 1fr;
    width: 100%;
    padding: 0 0 0 1;
    scrollbar-size-vertical: 1;
}

.side-item { height: 1; width: 100%; }
.side-item:hover { background: $primary 20%; }
/* Highlighted row in the explorer: arrow keys move it and Enter opens it. */
.side-item-on { background: $primary 30%; text-style: bold; }

/* The right agent column was replaced by the AGENT dock tab; its slot now
   hosts the file explorer (also closed by default to preserve editor width). */
#code-explorer {
    display: none;
    width: 30;
    height: 100%;
    border-left: solid $nex-line;
}

#explorer-search { height: 1; width: 100%; }
#explorer-mark { width: 3; height: 1; color: $accent; }
#explorer-find {
    width: 1fr;
    height: 1;
    border: none;
    background: transparent;
}

#explorer-list {
    height: 1fr;
    width: 100%;
    /* One-cell padding matching other panes so the list does not hug the divider. */
    padding: 0 0 0 1;
    scrollbar-size-vertical: 1;
}

/* Columns are toggled via inline styles in CodeScreen._fit_columns, which
   computes the minimum width reserved for the editor. */

/* Welcome overlay above the editor: uses overlay layer so the user can start
   typing immediately without dismissing it. */
#code-hello {
    display: none;
    layer: overlay;
    width: 64;
    height: auto;
    offset: 12 2;
    background: $nex-panel;
    padding: 0 2 1 0;
}

#code-edit {
    height: 1fr;
    /* 1fr instead of 100%: the examples column may open to the left of editor. */
    width: 1fr;
    border: none;
    padding: 0 0 0 1;
    background: transparent;
    color: $nex-text;
}

#code-edit:focus { border: none; background: transparent; }
#code-edit > .text-area--cursor-line { background: $primary 10%; }

/* --- bottom dock -------------------------------------------------------- */
/*
   Roughly one-third of the screen, like an IDE tool window: enough to read
   while keeping the editor primary. Separated by a top hairline; the active
   tab serves as its title.
*/

/* min-height 10 fits the full grid: top hairline (1), tab bar (1), cycle
   header (1), six channels (6), and horizontal scrollbar (1). All six channels
   (including exclusive divider channel ,5) must stay visible on 80x24. */
#code-dock {
    /* Initial height; actual height is set per active tab or resized by dragging
   the border. See CodeScreen.TAB_HEIGHT. */
    height: 12;
    min-height: 5;
    width: 100%;
    /* Canvas background instead of panel so the dock blends with the editor,
   columns, and footer rather than standing out as a lighter slab. */
    background: $nex-canvas;
}

/* Editor/dock drag handle: hover highlight signals it is draggable since
   terminals cannot change cursor shape. */
#dock-split {
    height: 1;
    width: 100%;
    color: $nex-line;
}

#dock-split:hover { color: $primary; background: $primary 20%; }

#dock-tabs { height: 1; width: 100%; background: $nex-canvas; padding: 0 1; }
#dock-sep { width: auto; height: 1; color: $nex-line; margin: 0 1; }
#dock-note { height: 1; width: 1fr; content-align: right middle; padding: 0 1; }

/* --- SCHEDULE tab ------------------------------------------------------- */

#dock-sched { height: 1fr; width: 100%; }
#code-grid-wrap { width: 1fr; height: 100%; padding: 0 0 0 1; }
#code-grid-orc-wrap { display: none; width: 1fr; height: 100%; }
/* auto instead of 1: before an exact search runs, shows a 3-line prompt to
   compute it rather than an empty half-screen. */
#code-grid-orc-head { height: auto; width: 100%; }

#code-grid, #code-grid-orc {
    background: transparent;
    height: 1fr;
    width: 100%;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

#code-grid > .datatable--header, #code-grid-orc > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}

#code-grid > .datatable--cursor, #code-grid-orc > .datatable--cursor {
    background: $primary 30%;
    color: $nex-title;
}

/* Grid breakdown (port utilization and suggested moves): shown ONLY when the
   dock is maximized (F11) so it does not steal a third of the grid width or
   duplicate the ISSUES tab. */
#sched-side {
    display: none;
    width: 46;
    height: 100%;
    border-left: solid $nex-line;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#sched-side-body { height: auto; width: 100%; }

/* --- INSPECT tab -------------------------------------------------------- */
/*
   Consolidates the cycle-under-cursor view and dependency chain (left) with
   the full buffer cycle catalog (right) in one two-column tab.
*/

#dock-line { height: 1fr; width: 100%; }

/* Numbers and machine summary appear only when INSPECT is maximized. */
#line-side {
    display: none;
    width: 38;
    height: 100%;
    padding: 0 1;
    border-left: solid $nex-line;
    scrollbar-size-vertical: 1;
}
#line-side-body { width: 100%; height: auto; }
ModeScreen.zoom-dock #line-side { display: block; }
ModeScreen.tight #line-side { display: none; }

#dock-line-col {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#code-line-info, #code-chain-body { height: auto; width: 100%; }

#dock-bundles {
    width: 46;
    height: 100%;
    border-left: solid $nex-line;
    scrollbar-size-vertical: 1;
}

/* --- ISSUES and OUTPUT tabs --------------------------------------------- */

#sched-empty { display: none; height: 1fr; width: 1fr; padding: 1 1 0 1; }

#dock-lint { height: 1fr; width: 100%; scrollbar-size-vertical: 1; }
#dock-term { height: 1fr; width: 100%; }

/* Input line inside OUTPUT — single-row terminal prompt. `height: 2` accounts
   for the 1-row top border under Textual's default border-box sizing so the
   input text remains visible (same calculation as #prompt-field above). */
#dock-term #prompt-field {
    height: 2;
    margin: 0;
    padding: 0 1;
}

#dock-term #console { height: 1fr; }

/* --- CORE tab: interpreter console -------------------------------------- */
/*
   Analogous to an IDE Python Console: response tape, input line below, and
   compact machine state on the right for building graphs with expressions.
*/

#dock-core { height: 1fr; width: 100%; }

/* Built-in kernels and verbs appear only when maximized (see CodeScreen.compose). */
/* Grid instead of a single row: eleven kernels would overflow horizontally;
   grid wraps cleanly within three rows. */
#core-chips {
    display: none;
    height: auto;
    max-height: 3;
    width: 100%;
    padding: 0 1;
}
ModeScreen.zoom-dock #core-chips { display: block; }
/* Machine state pane widens when maximized to show full names, memory, and
   accumulated graph. */
ModeScreen.zoom-dock #core-state-col { width: 44; }

/* AGENT tab: shared `session.dialog` tape and question line across the full
   dock width. Maximizing reveals the facts/trace sidebar, suggested questions,
   and action buttons. */
#dock-agent { height: 1fr; width: 100%; }
#agent-main { height: 1fr; width: 1fr; }
#agent-log-box { height: 1fr; width: 100%; scrollbar-size-vertical: 1; }
#agent-log { width: 100%; height: auto; padding: 0 1; }
/* Dock the question input at the bottom so suggested questions inserted when
   maximized cannot push it off-screen. */
#agent-prompt { height: 1; width: 100%; dock: bottom; }
#agent-mark { width: 3; height: 1; color: $accent; }
#agent-input { width: 1fr; height: 1; border: none; background: transparent; }

#agent-tools { display: none; height: 1; width: 100%; padding: 0 1; }
/* Suggested questions are always visible; maximizing reveals more of them. */
#agent-asks { height: auto; max-height: 2; width: 100%; padding: 0 1; }
ModeScreen.zoom-dock #agent-asks { max-height: 4; }
#agent-side {
    display: none;
    width: 40;
    height: 100%;
    padding: 0 1;
    border-left: solid $nex-line;
    scrollbar-size-vertical: 1;
}
#agent-seen, #agent-trace { width: 100%; height: auto; }

ModeScreen.zoom-dock #agent-tools { display: block; }
ModeScreen.zoom-dock #agent-side { display: block; width: 46; }
/* On narrow windows the facts column yields to the transcript. */
ModeScreen.narrow #agent-side { width: 30; }
ModeScreen.tight #agent-side { display: none; }
#core-log-box { width: 1fr; height: 100%; }

#core-log {
    height: 1fr;
    width: 100%;
    background: transparent;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

/* Single-row prompt with chevron; height: 2 includes the top hairline. */
#core-prompt {
    height: 2;
    width: 100%;
    border-top: solid $nex-line 30%;
}

#core-prompt:focus-within { border-top: solid $primary 55%; }
#core-mark { width: 3; height: 1; padding: 0; color: $nex-faint; }

#core-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}

#core-input > .input--placeholder { color: $nex-faint; text-style: none; }

#core-state-col {
    width: 30;
    height: 100%;
    padding: 0 1;
    border-left: solid $nex-line;
    scrollbar-size-vertical: 1;
}

#core-state { height: auto; width: 100%; }

/* Each issue is a clickable link that jumps the editor cursor to that line. */
.lint-item { height: auto; width: 100%; }
.lint-item:hover { background: $primary 20%; }

/* --- footer: single status bar at the very bottom ----------------------- */

#code-foot { dock: bottom; height: auto; width: 100%; }

#code-status-row { height: 1; width: 100%; background: $nex-shadow; }

#code-line-chip {
    width: auto;
    min-width: 24;
    height: 1;
    padding: 0 1 0 0;
}

#code-line-chip:hover { background: $primary 25%; }

#code-keys { width: auto; height: 1; padding: 0 2 0 1; }

#code-status { width: 1fr; height: 1; content-align: right middle; padding: 0 2 0 0; }

/* Status-bar launchers for issues and output: styled as plain text with hover
   feedback so the status bar does not look like a button toolbar. */
#status-lint, #status-term {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $nex-dim;
}

#status-lint:hover, #status-term:hover {
    background: $primary 25%;
    color: $nex-title;
    text-style: bold;
}

/* --- narrow and short window -------------------------------------------- */
/*
   Panes drop cleanly when space runs out rather than squishing to unreadable
   widths. The grid breakdown column drops first so the grid stays intact.
*/

ModeScreen.narrow #dock-bundles { width: 38; }
ModeScreen.tight #dock-bundles { display: none; }
ModeScreen.tight #sched-side { display: none; }
ModeScreen.narrow #core-state-col { width: 26; }
ModeScreen.tight #core-state-col { display: none; }

/* Left examples catalog drops first on narrow screens (still reachable via
   /example) instead of taking 20 of 80 columns. */
/* See above: column widths are managed by _fit_columns, not .tight. */

/* Short terminal (< 34 rows): lock the dock to a fixed height so the editor
   gets all remaining vertical space. */
ModeScreen.low #code-dock { height: 11; }
ModeScreen.very-low #code-dock { height: 10; }

/* Expanded dock: half screen to the tab, remainder to the editor. */
/* Maximized dock fills the entire screen symmetrically with double-clicking a
   file tab to maximize the editor. */
ModeScreen.zoom-dock #code-body { display: none; }
ModeScreen.zoom-dock #dock-split { display: none; }
/* 1fr instead of 100%: 100% is measured against the full screen and pushed the
   bottom of the dock (including the agent input line) under the status bar. */
ModeScreen.zoom-dock #code-dock { height: 1fr; }
ModeScreen.zoom-dock #code-grid-orc-wrap { display: block; }
/* Maximized dock has room to show the grid breakdown alongside the grid. */
ModeScreen.zoom-dock #sched-side { display: block; }

/* --- typing hints ------------------------------------------------------- */
/*
   Floats under the cursor on the `overlay` layer so transient completion hints
   never displace the editor layout.
*/

Suggest {
    display: none;
    layer: overlay;
    width: 52;
    height: auto;
    max-height: 9;
    background: $nex-raised;
    border: solid $primary;
    padding: 0;
}

.suggest-item { height: 1; width: 100%; }
.suggest-item:hover { background: $primary 25%; }
.suggest-on { background: $primary 35%; text-style: bold; }

/* --- mode picker -------------------------------------------------------- */

#picker-wrap {
    align: center middle;
    height: 1fr;
    width: 100%;
}

#picker-logo {
    height: auto;
    width: auto;
    margin-bottom: 1;
}

#picker-tagline {
    height: auto;
    width: auto;
    text-align: center;
    margin-bottom: 2;
}

#picker-cards {
    width: 78;
    height: auto;
    align-horizontal: center;
}

.mode-card {
    height: 6;
    width: 100%;
    padding: 0 2;
    margin-bottom: 1;
    background: $nex-panel;
    border: solid $nex-line;
}

.mode-card.selected {
    background: $nex-raised;
}

.mode-card:hover {
    background: $nex-raised;
}

#picker-hint {
    height: 1;
    width: auto;
    margin-top: 1;
}

/* Tight height breakpoints — shed cheapest chrome first (margins, card height,
   NEX logo, tagline). Cards are never hidden; logo drops late so it does not
   leave an 8-row gap to save 2 rows. */
PickerScreen.snug #picker-tagline { margin-bottom: 1; }
PickerScreen.snug .mode-card { margin-bottom: 0; }
PickerScreen.snug #picker-hint { margin-top: 0; }

PickerScreen.short .mode-card { height: 5; }

PickerScreen.tiny #picker-logo { display: none; }

PickerScreen.micro #picker-tagline { display: none; }
PickerScreen.micro .mode-card { height: 3; padding: 0 2; }

/* --- maximized LAB panels: each has its own layer ----------------------- */
/* Layers live inside the same panels and toggle on maximize via code. */

#numbers-why, #machine-matrix, #machine-foot, #detail-graph,
#machine-filter-row {
    display: none;
}

#numbers-why { height: 1fr; scrollbar-size-vertical: 1; }
#numbers-head { height: auto; }
#numbers-chain { height: auto; }
#numbers-res { height: auto; }

/* auto instead of 1fr so port utilization bars sit directly below the matrix
   instead of leaving a huge empty gap. */
#machine-matrix { height: auto; max-height: 60%; background: transparent; }
#machine-matrix > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}
#machine-matrix > .datatable--cursor { background: $primary 30%; }
#machine-matrix > .datatable--hover { background: $nex-raised; }
#machine-foot { height: auto; padding-top: 1; }

#machine-filter-row { height: 1; width: 100%; margin-bottom: 1; }
#machine-filter-label { width: 8; height: 1; color: $nex-faint; }
#machine-filter {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}
#machine-filter > .input--placeholder { color: $nex-faint; }

#detail-graph { height: 1fr; width: 100%; }
#detail-preds, #detail-succs { width: 1fr; height: 100%; }

/* Operation link: underlined on hover without adding a fifth color meaning. */
.instr-link { height: 1; width: 100%; }
.instr-link:hover { background: $nex-raised; }

/* --- run journal (maximized OUTPUT) ------------------------------------- */

ConsoleJournal { display: none; height: 1fr; width: 100%; }

/* Left column: session history. Width 32 fits `#12 14:02 c /code run`. */
#journal-side {
    width: 32;
    height: 100%;
    border-right: solid $nex-line 35%;
    padding-right: 1;
}

#journal-cmds-head, #journal-runs-head { height: 1; width: 100%; }
#journal-runs-head { margin-top: 1; }

/* Catalog takes only what it needs (capped at half the column) so RUNS stays
   right beneath it instead of floating in empty space. */
#journal-cmds { height: auto; max-height: 55%; scrollbar-size-vertical: 1; }
#journal-list { height: 1fr; scrollbar-size-vertical: 1; }

.cmd-item { height: 1; width: 100%; }
.cmd-item:hover { background: $nex-raised; }

#journal-right { width: 1fr; height: 100%; }

#journal-out {
    width: 100%;
    height: 1fr;
    background: transparent;
    padding-left: 2;
    scrollbar-size-vertical: 1;
}

/* Stream tabs: command reports or live events, matching schedule tab style. */
#feed-tabs { height: 1; width: 100%; margin-bottom: 1; }

#events-out {
    display: none;
    width: 100%;
    height: 1fr;
    background: transparent;
    padding-left: 2;
    scrollbar-size-vertical: 1;
}

/* Journal input line uses the same flat terminal prompt as the dock (single
   row, top hairline, no box border). */
#journal-field {
    height: 2;
    width: 100%;
    margin: 0;
    padding: 0 1;
    background: transparent;
    border: none;
    border-top: solid $nex-line 30%;
}

#journal-field:focus-within {
    background: transparent;
    border: none;
    border-top: solid $primary 55%;
}

#journal-mark { width: 2; height: 1; content-align: left middle; }

/* Persistent hint on the right side of the journal prompt. Named `journal-hint`
   (not `journal-side`, which is the 32-col left catalog column) to avoid id
   collision. */
#journal-hint {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $nex-faint;
    content-align: right middle;
}

#journal-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}

/* Hint invites typing rather than looking like scrollable output. */
#journal-input > .input--placeholder {
    color: $nex-dim;
    text-style: none;
}

/* History entry — two rows like a git log commit: who/when and state summary. */
.run-item { height: auto; width: 100%; }
.run-item:hover { background: $nex-raised; }
.run-item.on { background: $primary 18%; }

/* Bridge action row for sending the selected run to another view; shared by
   maximized journal (#run-actions) and compact CODE report (#drawer-bridge). */
BridgeRow {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}

/* Row label clarifies that buttons act on the selected history entry. */
.bridge-label {
    width: auto;
    height: 1;
    padding: 0 1 0 0;
    color: $nex-faint;
}

/* --- maximized CORE panels ---------------------------------------------- */

#names-wide, #mem-wide, #prog-wide { display: none; }

#names-wide, #prog-wide { height: 1fr; scrollbar-size-vertical: 1; }

#mem-wide { height: 1fr; }
#mem-head { height: auto; }
#mem-foot { height: auto; }

#mem-map {
    height: auto;
    width: 100%;
    grid-gutter: 0 2;
    padding: 1 0;
}

.mem-cell { height: 1; width: 9; }
.mem-cell.wrote { background: $nex-raised; }
.mem-cell:hover { background: $nex-raised; }

/* Compact MEMORY is the same map as maximized, just tighter, with the same
   clicks and store markers. */
#mem-mini { height: auto; width: 100%; }
#mem-mini-foot { height: auto; width: 100%; }
.mem-cell.mini { width: 8; }

/* PROGRAM — one op per row: clicking highlights the TAPE line that emitted it. */
#program { height: 1fr; width: 100%; scrollbar-size-vertical: 1; }

.prog-item { height: 1; width: 100%; padding: 0 1; }
.prog-item:hover { background: $nex-raised; }
.prog-item.hot {
    background: $primary 25%;
    color: $nex-title;
    text-style: bold;
}

/* --- floating question bar ---------------------------------------------- */
/* Docked at the bottom instead of the side so it does not steal a third of the
   width from a maximized panel; grows upward with the answer. */

PanelPrompt {
    dock: bottom;
    width: 100%;
    height: auto;
    max-height: 60%;
    background: $nex-panel;
    border: solid $primary;
    padding: 0 1;
    margin: 0 1 0 1;
}

#pp-header { height: 1; width: 100%; margin-bottom: 1; }
#pp-title { width: 1fr; height: 1; }

/* Close control styled like a chip ("x Esc") so the shortcut stays visible as
   text rather than only on hover. */
#pp-close {
    width: 7;
    height: 1;
    content-align: right middle;
    color: $nex-faint;
}
#pp-close:hover {
    color: $nex-title;
    background: $nex-raised;
    text-style: bold;
}

#pp-answer {
    height: auto;
    max-height: 14;
    scrollbar-size-vertical: 1;
}

.pp-line { height: auto; width: 100%; margin-bottom: 1; }

#pp-chips { height: auto; width: 100%; grid-gutter: 0 1; }

.prompt-chip {
    width: 1fr;
    height: 1;
    background: transparent;
    color: $nex-dim;
    margin-right: 1;
}

#pp-field { height: 1; width: 100%; }
#pp-mark { width: 2; height: 1; }

#pp-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}

#pp-input > .input--placeholder { color: $nex-faint; }

/* --- maximized AGENT panels --------------------------------------------- */

#seen-wide, #trace-wide { display: none; height: 1fr; scrollbar-size-vertical: 1; }

#scen-wide { display: none; height: 1fr; width: 100%; }
#scen-head { height: auto; }

#scen-filter-row { height: 1; width: 100%; margin-bottom: 1; }
#scen-filter-label { width: 8; height: 1; color: $nex-faint; }
#scen-filter {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}
#scen-filter > .input--placeholder { color: $nex-faint; }

#scen-table { height: auto; max-height: 60%; background: transparent; }
#scen-table > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}
#scen-table > .datatable--cursor { background: $primary 30%; }
#scen-table > .datatable--hover { background: $nex-raised; }
#scen-foot { height: auto; padding-top: 1; }

#kern-wide { display: none; height: 1fr; scrollbar-size-vertical: 1; }
