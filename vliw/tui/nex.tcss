/* ------------------------------------------------------------------------
   NEX — оформление интерфейса.

   Цвета сюда попадают из палитры проекта (vliw/ui/themes/*.json) через
   переменные $nex-*: одна и та же тема красит и построчный вывод, и этот
   экран. Здесь задаётся только вёрстка и иерархия поверхностей.

   Поверхности:  canvas (полотно) < panel (панель) < raised (активное).
   Акцент ($primary) свой у каждого режима и приходит из темы приложения.
   ------------------------------------------------------------------------ */

Screen {
    background: $nex-canvas;
    color: $nex-text;
}

/* --- шапка режима ------------------------------------------------------ */

TopBar {
    dock: top;
    height: 1;
    width: 100%;
    padding: 0 2;
    background: $nex-shadow;
}

/* --- док ввода --------------------------------------------------------- */

#dock {
    dock: bottom;
    height: auto;
    width: 100%;
    background: $nex-shadow;
}

PromptBar {
    height: auto;
    width: 100%;
}

#prompt-field {
    height: 3;
    width: 100%;
    margin: 0 1;
    padding: 0 1;
    background: $nex-raised;
    border: round $nex-line;
}

#prompt-field:focus-within {
    border: round $primary;
}

#prompt-mark {
    width: 6;
    height: 1;
    content-align: left middle;
}

#prompt-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
    text-style: bold;
}

#prompt-input > .input--placeholder {
    color: $nex-faint;
    text-style: none;
}

#prompt-side {
    width: auto;
    height: 1;
    padding: 0 1;
    content-align: right middle;
}

HintBar {
    height: 1;
    width: 100%;
    padding: 0 2;
    background: $nex-shadow;
}

/* --- палитра команд ---------------------------------------------------- */

Palette {
    max-height: 12;
    height: auto;
    width: 100%;
    background: $nex-panel;
    border: none;
    border-left: thick $primary;
    padding: 0;
    scrollbar-size-vertical: 1;
}

Palette > .option-list--option-highlighted {
    background: $primary 25%;
    color: $nex-title;
    text-style: bold;
}

/* --- панели ------------------------------------------------------------ */

Panel {
    border: round $nex-line;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $nex-dim;
    background: $nex-panel;
    padding: 0 1;
    height: 1fr;
}

Panel:focus-within {
    border: round $primary;
    border-title-color: $primary;
}

/* Развёрнутая панель занимает весь экран — чем бы ни была её обычная высота.
   Textual вешает класс `-maximized` на развёрнутый виджет, но собственная
   высота панели никуда не девается: у половины панелей она задана числом по
   id (#p-console: 10, #p-detail: 9, #p-seen: 12), и по специфичности id
   побеждает класс. Получалась узкая полоска посреди пустого экрана вместо
   разворота — а разворачивают как раз те панели, где текст не помещается.
   `!important` здесь по делу: развёрнутое состояние обязано перебивать
   любую обычную раскладку. */
Panel.-maximized {
    height: 100% !important;
    max-height: 100% !important;
    min-height: 0 !important;
    width: 100% !important;
}

/* Развёрнутая панель с чатом уступает ему треть ширины. Панель остаётся
   слева: читают её, а спрашивают о прочитанном. */
/* 1fr, а не проценты: чат пристыкован справа, и панель должна занять ровно
   остаток. С процентами она вставала бы по центру, оставляя пустые поля с
   обеих сторон. */
Panel.-maximized.with-chat {
    width: 1fr !important;
}

/* Без layer: слой висит ПОВЕРХ раскладки и места под себя не резервирует —
   панель оставалась во всю ширину, а чат её перекрывал. Обычный dock
   отбирает свою долю честно. */
PanelChat {
    width: 34%;
    height: 100%;
    background: $nex-panel;
    border: round $primary;
    border-title-align: left;
    padding: 0 1;
}

PanelChat.right { dock: right; }

/* У панелей со своей строкой ввода чат встаёт слева: справа уже занято их
   собственным вводом, и два поля рядом путают, куда печатать. */
PanelChat.left { dock: left; }

#pchat-log {
    height: 1fr;
    overflow-y: auto;
}

#pchat-input {
    dock: bottom;
    border: none;
    border-top: solid $nex-line;
    background: transparent;
    height: 2;
}

Console {
    background: transparent;
    scrollbar-size-vertical: 1;
    padding: 0;
}

/* --- ЯДРО: верстак интерпретатора -------------------------------------- */

#core-body {
    height: 1fr;
    width: 100%;
}

#core-left {
    width: 1fr;
    height: 100%;
}

#core-right {
    width: 46;
    height: 100%;
}

#p-tape { height: 1fr; }

#p-kernels {
    height: 4;
    padding: 0 1;
}

#kernel-chips, #verb-chips {
    height: 1;
    width: 100%;
}

.chip-label {
    width: 6;
    height: 1;
    color: $nex-faint;
}

#p-names { height: 1fr; min-height: 6; }
#p-mem   { height: 9; }
#p-prog  { height: 2fr; min-height: 8; }

.chip {
    height: 1;
    width: auto;
    padding: 0 1;
    margin-right: 1;
    background: $nex-raised;
    color: $nex-dim;
}

.chip:hover {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

.chip-kernel { color: $nex-accent-soft; }

/* --- РАЗБОР: расписание, которое можно потрогать ------------------------ */

#lab-body { height: 1fr; width: 100%; }
#lab-left { width: 1fr; height: 100%; }
#lab-right { width: 42; height: 100%; }

#p-scen {
    height: auto;
    max-height: 7;
    padding: 0 1;
}

#view-chips { height: 1; width: 100%; }
#scenario-chips { height: auto; width: 100%; grid-gutter: 0; }

.chip-view { color: $nex-dim; }

.chip-on {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

.chip-scen {
    width: 1fr;
    margin-right: 1;
    background: transparent;
    color: $nex-dim;
}

#p-grid { height: 1fr; min-height: 8; }
#p-detail { height: 9; }
#p-console { height: 10; }

#grid {
    background: transparent;
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

/* Мостик под решёткой к развёрнутому ДИАГНОЗУ. `display: none` — не
   украшение, а обязательство: в обычном виде он отбирал у расписания целую
   строку (было видно до т.21, стало до т.20), то есть платил главным окном
   инструмента за подсказку, которая нужна только развёрнутой решётке.
   Показывается из кода ровно на время разворота. */
#grid-link {
    display: none;
    height: 1;
    padding: 0 1;
}

#grid-link.on { display: block; }

/* --- ДИАГНОЗ: полный список находок при развороте ---------------------- */

#diag-filter {
    height: auto;
    width: 100%;
}

.diag-sev {
    width: auto;
}

.finding-row {
    height: auto;
    width: 100%;
    margin-bottom: 1;
    padding: 0 1;
}

.finding-row:hover {
    background: $nex-raised;
}

/* Находка про клетку под курсором. Не заливка на всю ширину — она читалась
   как отдельный блок и спорила с рамкой панели, — а полоса слева: тот же
   приём, что у цитаты в тексте. */
.finding-row.here {
    border-left: thick $primary;
    padding-left: 1;
}

#diag-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#grid > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}

#grid > .datatable--cursor {
    background: $primary 35%;
    color: $nex-title;
}

#grid > .datatable--hover {
    background: $nex-raised;
}

#p-numbers  { height: 9; }
#p-diag     { height: 1fr; min-height: 8; }
#p-machine  { height: auto; min-height: 6; max-height: 10; }

/* --- АГЕНТ: диалог, у которого видно основание -------------------------- */

#mind-body { height: 1fr; width: 100%; }
#mind-left { width: 1fr; height: 100%; }
#mind-right { width: 42; height: 100%; }

#p-chat { height: 1fr; }
#p-questions { height: auto; max-height: 6; padding: 0 1; }
#question-chips { height: auto; width: 100%; }

.chip-question {
    width: 1fr;
    margin-right: 1;
    background: transparent;
    color: $nex-mind-soft;
}

#chat {
    height: 100%;
    scrollbar-size-vertical: 1;
}

.msg-you {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.msg-mark { height: 1; width: 100%; }

.msg-nex {
    height: auto;
    width: 100%;
    padding-left: 2;
    margin-bottom: 1;
}

.msg-note {
    height: auto;
    width: 100%;
    color: $nex-dim;
    margin-bottom: 1;
}

#p-seen  { height: 12; }
#p-trace { height: 1fr; min-height: 6; }
#p-mind-console { height: 12; }

/* --- узкое окно --------------------------------------------------------- */

ModeScreen.narrow #core-right,
ModeScreen.narrow #lab-right,
ModeScreen.narrow #mind-right { width: 38; }

ModeScreen.narrow #p-detail { height: 8; }
ModeScreen.narrow #p-console { height: 7; }
ModeScreen.narrow #p-mind-console { height: 8; }
ModeScreen.narrow #p-seen { height: 11; }

ModeScreen.tight #core-right,
ModeScreen.tight #lab-right,
ModeScreen.tight #mind-right { width: 34; }

ModeScreen.tight #p-kernels,
ModeScreen.tight #p-scen,
ModeScreen.tight #p-questions { display: none; }

ModeScreen.tight #p-console { height: 5; }

/* --- выбор режима ------------------------------------------------------ */

#picker-wrap {
    align: center middle;
    height: 1fr;
    width: 100%;
}

#picker-logo {
    height: auto;
    width: auto;
    margin-bottom: 1;
}

#picker-tagline {
    height: auto;
    width: auto;
    text-align: center;
    margin-bottom: 2;
}

#picker-cards {
    width: 78;
    height: auto;
    align-horizontal: center;
}

.mode-card {
    height: 6;
    width: 100%;
    padding: 0 2;
    margin-bottom: 1;
    background: $nex-panel;
    border: round $nex-line;
}

.mode-card.selected {
    background: $nex-raised;
}

.mode-card:hover {
    background: $nex-raised;
}

#picker-hint {
    height: 1;
    width: auto;
    margin-top: 1;
}

/* --- развёрнутые панели РАЗБОРА: у каждой свой слой --------------------- */
/* Слои живут в тех же панелях и включаются только на разворот: рисование
   зависит от режима, а не от размера, поэтому переключает их код. */

#numbers-why, #machine-matrix, #machine-foot, #detail-graph {
    display: none;
}

#numbers-why { height: 1fr; scrollbar-size-vertical: 1; }
#numbers-head { height: auto; }
#numbers-chain { height: auto; }
#numbers-res { height: auto; }

/* auto, а не 1fr: с 1fr таблица распирала себя на весь экран, и занятость
   портов уезжала в самый низ — между матрицей и полосами зияло полтысячи
   пустых строк. Блоки должны идти подряд, пустота — оставаться под ними. */
#machine-matrix { height: auto; max-height: 60%; background: transparent; }
#machine-matrix > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}
#machine-matrix > .datatable--cursor { background: $primary 30%; }
#machine-matrix > .datatable--hover { background: $nex-raised; }
#machine-foot { height: auto; padding-top: 1; }

#detail-graph { height: 1fr; width: 100%; }
#detail-preds, #detail-succs { width: 1fr; height: 100%; }

/* Ссылка на операцию: подчёркнута наведением, как ссылка и должна быть.
   Отдельного цвета не получает — цвет в этом интерфейсе уже занят
   операциями и режимом, и пятый смысл он бы не выдержал. */
.instr-link { height: 1; width: 100%; }
.instr-link:hover { background: $nex-raised; }

/* --- журнал запусков (развёрнутый ВЫВОД КОМАНД) ------------------------- */

ConsoleJournal { display: none; height: 1fr; width: 100%; }

#journal-list {
    width: 40;
    height: 100%;
    border-right: solid $nex-line;
    padding-right: 1;
}

#journal-out {
    width: 1fr;
    height: 100%;
    background: transparent;
    padding-left: 2;
    scrollbar-size-vertical: 1;
}

.run-item { height: 1; width: 100%; }
.run-item:hover { background: $nex-raised; }
.run-item.on { background: $primary 18%; }

/* --- развёрнутые панели ЯДРА -------------------------------------------- */

#names-wide, #mem-wide, #prog-wide { display: none; }

#names-wide, #prog-wide { height: 1fr; scrollbar-size-vertical: 1; }

#mem-wide { height: 1fr; }
#mem-head { height: auto; }
#mem-foot { height: auto; }

#mem-map {
    height: auto;
    width: 100%;
    grid-gutter: 0 2;
    padding: 1 0;
}

.mem-cell { height: 1; width: 9; }
.mem-cell.wrote { background: $nex-raised; }
.mem-cell:hover { background: $nex-raised; }

/* --- всплывающая строка вопроса ----------------------------------------- */
/* Снизу, а не сбоку: колонка отбирала треть ширины у того, ради чего панель
   и разворачивают. Строка лежит поверх нижнего края и растёт вверх ответом. */

PanelPrompt {
    dock: bottom;
    width: 100%;
    height: auto;
    max-height: 60%;
    background: $nex-panel;
    border: round $primary;
    border-title-align: left;
    border-title-style: bold;
    padding: 0 1;
    margin: 0 1 0 1;
}

#pp-answer {
    height: auto;
    max-height: 14;
    scrollbar-size-vertical: 1;
}

.pp-line { height: auto; width: 100%; margin-bottom: 1; }

#pp-chips { height: auto; width: 100%; grid-gutter: 0 1; }

.prompt-chip {
    width: 1fr;
    height: 1;
    background: transparent;
    color: $nex-dim;
    margin-right: 1;
}

#pp-field { height: 1; width: 100%; }
#pp-mark { width: 2; height: 1; }

#pp-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}

#pp-input > .input--placeholder { color: $nex-faint; }

/* --- развёрнутые панели АГЕНТА ------------------------------------------ */

#seen-wide, #trace-wide { display: none; height: 1fr; scrollbar-size-vertical: 1; }

#scen-wide { display: none; height: 1fr; scrollbar-size-vertical: 1; }

#tape-wide, #kern-wide { display: none; height: 1fr; scrollbar-size-vertical: 1; }
