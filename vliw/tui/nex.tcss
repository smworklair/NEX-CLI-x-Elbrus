/* ------------------------------------------------------------------------
   NEX — оформление интерфейса.

   Цвета сюда попадают из палитры проекта (vliw/ui/themes/*.json) через
   переменные $nex-*: одна и та же тема красит и построчный вывод, и этот
   экран. Здесь задаётся только вёрстка и иерархия поверхностей.

   Поверхности:  canvas (полотно) < panel (панель) < raised (активное).
   Акцент ($primary) свой у каждого режима и приходит из темы приложения.
   ------------------------------------------------------------------------ */

Screen {
    background: $nex-canvas;
    color: $nex-text;
}

/* --- шапка режима ------------------------------------------------------ */

TopBar {
    dock: top;
    height: 1;
    width: 100%;
    padding: 0 2;
    background: $nex-shadow;
}

/* --- док ввода --------------------------------------------------------- */
/* Поле ввода — три строки: строка текста с полем сверху и снизу. Рамка
    съедала место у главного блока экрана, а «сюда можно печатать» показывают
    и фон, и подсветка строки при фокусе; высота делает док заметным якорем
    экрана — его видно краем глаза, даже когда читаешь панели. */

#dock {
    dock: bottom;
    height: auto;
    width: 100%;
    background: $nex-shadow;
}

PromptBar {
    height: auto;
    width: 100%;
}

#prompt-field {
    height: 3;
    width: 100%;
    margin: 0 1;
    padding: 1 1;
    background: $nex-raised;
}

#prompt-field:focus-within {
    background: $primary 18%;
}

/* Дети — по одной строке: центрирует их сам паддинг поля, и текст с
    курсором встают ровно на средний ряд. */

#prompt-mark {
    width: 6;
    height: 1;
    content-align: left middle;
}

#prompt-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
    text-style: bold;
}

#prompt-input > .input--placeholder {
    color: $nex-faint;
    text-style: none;
}

#prompt-side {
    width: auto;
    height: 1;
    padding: 0 1;
    content-align: right middle;
}

HintBar {
    height: 1;
    width: 100%;
    padding: 0 2;
    background: $nex-shadow;
}

/* --- палитра команд ---------------------------------------------------- */

Palette {
    max-height: 12;
    height: auto;
    width: 100%;
    background: $nex-panel;
    border: none;
    border-left: thick $primary;
    padding: 0;
    scrollbar-size-vertical: 1;
}

Palette > .option-list--option-highlighted {
    background: $primary 25%;
    color: $nex-title;
    text-style: bold;
}

/* --- панели ------------------------------------------------------------ */

Panel {
    border: round $nex-line;
    border-title-align: left;
    border-title-style: bold;
    border-title-color: $nex-dim;
    background: $nex-panel;
    padding: 0 1;
    height: 1fr;
}

Panel:focus-within {
    border: round $primary;
    border-title-color: $primary;
}

/* --- инструменты развёрнутой панели ------------------------------------- */
/* Полоса инструментов живёт ПЕРВЫМ ребёнком панели и показывается CSS-ом
    только у Panel.-maximized: в обычном виде она не отнимает ни строки,
    в развёрнутом — даёт панели её собственные инструменты (навигацию,
    тумблеры, переходы в связные панели), а не «ту же панель крупнее». */

PanelToolbar {
    display: none;
    height: 1;
    width: 100%;
}

Panel.-maximized PanelToolbar {
    display: block;
}

Tool {
    height: 1;
    width: auto;
    padding: 0 1;
    margin-right: 1;
    background: $nex-raised;
    color: $nex-dim;
}

Tool:hover {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

Tool.tool-on {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

/* Развёрнутая панель занимает весь экран — чем бы ни была её обычная высота.
   Textual вешает класс `-maximized` на развёрнутый виджет, но собственная
   высота панели никуда не девается: у половины панелей она задана числом по
   id (#p-console: 10, #p-detail: 9, #p-seen: 12), и по специфичности id
   побеждает класс. Получалась узкая полоска посреди пустого экрана вместо
   разворота — а разворачивают как раз те панели, где текст не помещается.
   `!important` здесь по делу: развёрнутое состояние обязано перебивать
   любую обычную раскладку. */
Panel.-maximized {
    height: 100% !important;
    max-height: 100% !important;
    min-height: 0 !important;
    width: 100% !important;
}

/* Развёрнутая панель с чатом уступает ему треть ширины. Панель остаётся
   слева: читают её, а спрашивают о прочитанном. */
/* 1fr, а не проценты: чат пристыкован справа, и панель должна занять ровно
   остаток. С процентами она вставала бы по центру, оставляя пустые поля с
   обеих сторон. */
Panel.-maximized.with-chat {
    width: 1fr !important;
}

/* Без layer: слой висит ПОВЕРХ раскладки и места под себя не резервирует —
   панель оставалась во всю ширину, а чат её перекрывал. Обычный dock
   отбирает свою долю честно. */
PanelChat {
    width: 34%;
    height: 100%;
    background: $nex-panel;
    border: round $primary;
    border-title-align: left;
    padding: 0 1;
}

PanelChat.right { dock: right; }

/* У панелей со своей строкой ввода чат встаёт слева: справа уже занято их
   собственным вводом, и два поля рядом путают, куда печатать. */
PanelChat.left { dock: left; }

#pchat-log {
    height: 1fr;
    overflow-y: auto;
}

#pchat-input {
    dock: bottom;
    border: none;
    border-top: solid $nex-line;
    background: transparent;
    height: 2;
}

Console {
    background: transparent;
    scrollbar-size-vertical: 1;
    padding: 0;
}

/* --- ЯДРО: верстак интерпретатора -------------------------------------- */

#core-body {
    height: 1fr;
    width: 100%;
}

#core-left {
    width: 1fr;
    height: 100%;
}

#core-right {
    width: 42;
    height: 100%;
}

#p-tape { height: 1fr; }

#p-kernels {
    height: 4;
    padding: 0 1;
}

#kernel-chips, #verb-chips {
    height: 1;
    width: 100%;
}

.chip-label {
    width: 6;
    height: 1;
    color: $nex-faint;
}

#p-names { height: 1fr; min-height: 6; }
#p-mem   { height: 7; }
#p-prog  { height: 2fr; min-height: 8; }

.chip {
    height: 1;
    width: auto;
    padding: 0 1;
    margin-right: 1;
    background: $nex-raised;
    color: $nex-dim;
}

.chip:hover {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

.chip-kernel { color: $nex-accent-soft; }

/* --- РАЗБОР: расписание, которое можно потрогать ------------------------ */
/* Расписание — главный блок экрана, и высоты остальных панелей держатся
    нарочно малыми: УЧАСТОК — полоса чипов, «почему здесь» и вывод команд —
    узкие окна. Всё освободившееся забирает решётка (#p-grid, 1fr). */

#lab-body { height: 1fr; width: 100%; }
#lab-left { width: 1fr; height: 100%; }
#lab-right { width: 46; height: 100%; }

#p-scen {
    height: auto;
    max-height: 5;
    padding: 0 1;
}

#view-chips { height: auto; width: auto; }
#scenario-chips { height: auto; width: 100%; grid-gutter: 0; }

/* Строка над решёткой: слева переключатель вида, справа живой счёт. */
#grid-head { height: 1; width: 100%; }
#grid-hud {
    width: 1fr;
    height: 1;
    content-align: right middle;
    color: $nex-dim;
}

/* Разворот решётки: слева решётка, справа инспектор. Рамка и отступ —
    чтобы колонка читалась отдельной панелью со своими секциями
    (КУРСОР / НАХОДКА / КАНАЛЫ / КЛАВИШИ), а не пустотой рядом. */
#grid-main { height: 1fr; width: 100%; }

#grid-side {
    display: none;
    width: 44;
    height: 100%;
    border-left: thick $nex-line;
    padding: 0 0 0 1;
    background: $nex-panel;
}

Panel.-maximized #grid-side { display: block; }

.chip-view { color: $nex-dim; }

.chip-on {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

.chip-scen {
    width: 1fr;
    margin-right: 1;
    background: transparent;
    color: $nex-dim;
}

#p-grid { height: 1fr; min-height: 8; }
#p-console { height: 7; }

#grid {
    background: transparent;
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

/* Мостик под решёткой к развёрнутому ДИАГНОЗУ. `display: none` — не
   украшение, а обязательство: в обычном виде он отбирал у расписания целую
   строку (было видно до т.21, стало до т.20), то есть платил главным окном
   инструмента за подсказку, которая нужна только развёрнутой решётке.
   Показывается из кода ровно на время разворота. */
#grid-link {
    display: none;
    height: 1;
    padding: 0 1;
}

#grid-link.on { display: block; }

/* --- ДИАГНОЗ: полный список находок при развороте ---------------------- */

#diag-filter {
    height: auto;
    width: 100%;
}

.diag-sev {
    width: auto;
}

.finding-row {
    height: auto;
    width: 100%;
    margin-bottom: 1;
    padding: 0 1;
}

.finding-row:hover {
    background: $nex-raised;
}

/* Находка про клетку под курсором. Не заливка на всю ширину — она читалась
   как отдельный блок и спорила с рамкой панели, — а полоса слева: тот же
   приём, что у цитаты в тексте. */
.finding-row.here {
    border-left: thick $primary;
    padding-left: 1;
}

#diag-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#grid > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}

#grid > .datatable--cursor {
    background: $primary 35%;
    color: $nex-title;
}

#grid > .datatable--hover {
    background: $nex-raised;
}

/* ДИАГНОЗ свёрнут до строки-сводки: подробности дублируют решётку
    (простой виден строкой, находка под курсором — в инспекторе разворота),
    панель держит только «сколько проблем и какая хуже». Полный список —
    по 2×клику или клавише d из решётки. */
/* Правая колонка: ЧИСЛА и ПОЧЕМУ ЗДЕСЬ — по содержимому, ДИАГНОЗ забирает
    остаток (список прокручивается), МАШИНА ограничена сверху. */
#p-numbers  { height: auto; }
#p-detail   { height: auto; }
#p-diag     { height: 1fr; }
#p-machine  { height: auto; min-height: 6; max-height: 9; }

/* --- АГЕНТ: диалог, у которого видно основание -------------------------- */

#mind-body { height: 1fr; width: 100%; }
#mind-left { width: 1fr; height: 100%; }
#mind-right { width: 42; height: 100%; }

#p-chat { height: 1fr; }

/* Развёрнутый ДИАЛОГ: слева история вопросов (шириной как журнал запусков),
   справа лента. Колонку включает код при развороте — тот же приём со слоями,
   что и у остальных панелей: рисование зависит от режима, а не от размера. */
#chat-body { width: 100%; height: 100%; }

#chat-hist-col {
    display: none;
    width: 46;
    height: 100%;
    border-right: solid $nex-line;
    padding-right: 1;
}

#chat-hist {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

.hist-item {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.hist-item:hover { background: $nex-raised; }
#p-questions { height: auto; max-height: 6; padding: 0 1; }
#question-chips { height: auto; width: 100%; }

.chip-question {
    width: 1fr;
    margin-right: 1;
    background: transparent;
    color: $nex-mind-soft;
}

#chat {
    height: 100%;
    width: 1fr;
    scrollbar-size-vertical: 1;
}

.msg-you {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.msg-mark { height: 1; width: 100%; }

.msg-nex {
    height: auto;
    width: 100%;
    padding-left: 2;
    margin-bottom: 1;
}

.msg-note {
    height: auto;
    width: 100%;
    color: $nex-dim;
    margin-bottom: 1;
}

#p-seen  { height: 10; }
#p-trace { height: 1fr; min-height: 6; }
#p-mind-console { height: 8; }

/* --- узкое окно --------------------------------------------------------- */

ModeScreen.narrow #core-right,
ModeScreen.narrow #lab-right { width: 40; }
ModeScreen.narrow #mind-right { width: 38; }

ModeScreen.narrow #p-console { height: 6; }
ModeScreen.narrow #p-mind-console { height: 6; }
ModeScreen.narrow #p-seen { height: 9; }

ModeScreen.tight #core-right,
ModeScreen.tight #lab-right,
ModeScreen.tight #mind-right { width: 34; }

ModeScreen.tight #p-kernels,
ModeScreen.tight #p-scen,
ModeScreen.tight #p-questions { display: none; }

ModeScreen.tight #p-console { height: 4; }

/* --- КОД: исходник и его расписание ------------------------------------- */

#code-body { height: 1fr; width: 100%; }
#p-code { width: 1fr; }
#code-right { width: 48; height: 100%; }

#code-main { height: 1fr; width: 100%; }

/* Редактор: без собственной рамки (рамкой служит панель), фон прозрачен —
    полотно режима. Курсор и выделение красит акцент темы. */
#code-edit {
    height: 100%;
    width: 1fr;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-text;
}

#code-edit:focus {
    border: none;
    background: transparent;
}

#code-edit > .text-area--cursor-line {
    background: $primary 10%;
}

/* «ЭТА СТРОКА» — колонка разворота ИСХОДНИКА. В обычном виде её нет: треть
    ширины редактора под справку о строке дороже самой справки. В развороте
    места хватает, и рядом с кодом появляется ответ на главный вопрос —
    почему операция встанет именно в этот такт. */
#code-side {
    display: none;
    width: 46;
    height: 100%;
    border-left: thick $nex-line;
    padding: 0 1;
    background: $nex-panel;
    scrollbar-size-vertical: 1;
}

Panel.-maximized #code-side { display: block; }

/* Строка итога под редактором: сколько тактов стоит написанное. */
#code-status {
    height: 1;
    width: 100%;
    background: $nex-shadow;
}

#p-code-sched { height: 1fr; min-height: 9; }

/* Вкладки решётки: две кнопки и счёт тактов справа. Видны всегда — в
    отличие от полосы инструментов, которая приходит только с разворотом. */
#sched-tabs { height: 1; width: 100%; }
#sched-head { height: 1; width: 1fr; content-align: right middle; }
#code-grids { height: 1fr; width: 100%; }
#code-grid-wrap { width: 1fr; height: 100%; }
#code-grid-orc-wrap { display: none; width: 1fr; height: 100%; }

/* Разбор решётки — только в развороте: в колонке 48 знаков ширины он отнял
    бы место у самой решётки, ради которой панель и открыта. */
#sched-side {
    display: none;
    width: 46;
    height: 100%;
    border-left: thick $nex-line;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

Panel.-maximized #sched-side { display: block; }
#sched-side-body { height: auto; width: 100%; }
#code-grid-orc-head { height: 1; width: 100%; }

#code-grid, #code-grid-orc {
    background: transparent;
    height: 1fr;
    width: 100%;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

#code-grid > .datatable--header, #code-grid-orc > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}

#code-grid > .datatable--cursor, #code-grid-orc > .datatable--cursor {
    background: $primary 30%;
    color: $nex-title;
}

#p-code-lint { height: 12; }
#lint-scroll { height: 1fr; width: 100%; scrollbar-size-vertical: 1; }

/* Замечание — не абзац текста, а ссылка: клик ведёт курсор на строку. */
.lint-item {
    height: auto;
    width: 100%;
    padding: 0 0 0 0;
}

.lint-item:hover {
    background: $primary 20%;
}

#p-code-out { height: 8; }

ModeScreen.narrow #code-right { width: 42; }
ModeScreen.narrow #p-code-lint { height: 9; }
ModeScreen.narrow #p-code-out { height: 6; }
ModeScreen.tight #code-right { width: 36; }
ModeScreen.tight #p-code-lint { height: 7; }
ModeScreen.tight #p-code-out { height: 5; }

/* --- выбор режима ------------------------------------------------------ */

#picker-wrap {
    align: center middle;
    height: 1fr;
    width: 100%;
}

#picker-logo {
    height: auto;
    width: auto;
    margin-bottom: 1;
}

#picker-tagline {
    height: auto;
    width: auto;
    text-align: center;
    margin-bottom: 2;
}

#picker-cards {
    width: 78;
    height: auto;
    align-horizontal: center;
}

.mode-card {
    height: 6;
    width: 100%;
    padding: 0 2;
    margin-bottom: 1;
    background: $nex-panel;
    border: round $nex-line;
}

.mode-card.selected {
    background: $nex-raised;
}

.mode-card:hover {
    background: $nex-raised;
}

#picker-hint {
    height: 1;
    width: auto;
    margin-top: 1;
}

/* --- развёрнутые панели РАЗБОРА: у каждой свой слой --------------------- */
/* Слои живут в тех же панелях и включаются только на разворот: рисование
   зависит от режима, а не от размера, поэтому переключает их код. */

#numbers-why, #machine-matrix, #machine-foot, #detail-graph,
#machine-filter-row {
    display: none;
}

#numbers-why { height: 1fr; scrollbar-size-vertical: 1; }
#numbers-head { height: auto; }
#numbers-chain { height: auto; }
#numbers-res { height: auto; }

/* auto, а не 1fr: с 1fr таблица распирала себя на весь экран, и занятость
   портов уезжала в самый низ — между матрицей и полосами зияло полтысячи
   пустых строк. Блоки должны идти подряд, пустота — оставаться под ними. */
#machine-matrix { height: auto; max-height: 60%; background: transparent; }
#machine-matrix > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}
#machine-matrix > .datatable--cursor { background: $primary 30%; }
#machine-matrix > .datatable--hover { background: $nex-raised; }
#machine-foot { height: auto; padding-top: 1; }

#machine-filter-row { height: 1; width: 100%; margin-bottom: 1; }
#machine-filter-label { width: 8; height: 1; color: $nex-faint; }
#machine-filter {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}
#machine-filter > .input--placeholder { color: $nex-faint; }

#detail-graph { height: 1fr; width: 100%; }
#detail-preds, #detail-succs { width: 1fr; height: 100%; }

/* Ссылка на операцию: подчёркнута наведением, как ссылка и должна быть.
   Отдельного цвета не получает — цвет в этом интерфейсе уже занят
   операциями и режимом, и пятый смысл он бы не выдержал. */
.instr-link { height: 1; width: 100%; }
.instr-link:hover { background: $nex-raised; }

/* --- журнал запусков (развёрнутый ВЫВОД КОМАНД) ------------------------- */

ConsoleJournal { display: none; height: 1fr; width: 100%; }

/* Левая колонка узкая нарочно: главное здесь — вывод справа. Раньше она
   занимала 40 колонок из 150 при том, что длиннее «/load <файл.s>» там
   ничего не бывает. 26 — по самой длинной команде с аргументом. */
#journal-side {
    width: 26;
    height: 100%;
    border-right: solid $nex-line;
    padding-right: 1;
}

#journal-cmds-head, #journal-runs-head { height: 1; width: 100%; }
#journal-runs-head { margin-top: 1; }

/* Каталог занимает столько, сколько в нём есть (но не больше половины
   колонки), а запуски забирают остаток. С фиксированным 1fr каталог держал
   половину даже когда в нём после фильтра три строки, и ЗАПУСКИ висели
   посреди пустоты. */
#journal-cmds { height: auto; max-height: 55%; scrollbar-size-vertical: 1; }
#journal-list { height: 1fr; scrollbar-size-vertical: 1; }

.cmd-item { height: 1; width: 100%; }
.cmd-item:hover { background: $nex-raised; }

#journal-right { width: 1fr; height: 100%; }

#journal-out {
    width: 100%;
    height: 1fr;
    background: transparent;
    padding-left: 2;
    scrollbar-size-vertical: 1;
}

/* Строка ввода терминала — тот же минималистичный вид, что у общего дока:
    одна строка, фон вместо рамки. */
#journal-field {
    height: 1;
    width: 100%;
    margin: 0 0 0 2;
    padding: 0 1;
    background: $nex-raised;
}

#journal-field:focus-within { background: $primary 18%; }

#journal-mark { width: 6; height: 1; content-align: left middle; }

#journal-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
    text-style: bold;
}

#journal-input > .input--placeholder {
    color: $nex-faint;
    text-style: none;
}

.run-item { height: 1; width: 100%; }
.run-item:hover { background: $nex-raised; }
.run-item.on { background: $primary 18%; }

/* --- развёрнутые панели ЯДРА -------------------------------------------- */

#names-wide, #mem-wide, #prog-wide { display: none; }

#names-wide, #prog-wide { height: 1fr; scrollbar-size-vertical: 1; }

#mem-wide { height: 1fr; }
#mem-head { height: auto; }
#mem-foot { height: auto; }

#mem-map {
    height: auto;
    width: 100%;
    grid-gutter: 0 2;
    padding: 1 0;
}

.mem-cell { height: 1; width: 9; }
.mem-cell.wrote { background: $nex-raised; }
.mem-cell:hover { background: $nex-raised; }

/* --- всплывающая строка вопроса ----------------------------------------- */
/* Снизу, а не сбоку: колонка отбирала треть ширины у того, ради чего панель
   и разворачивают. Строка лежит поверх нижнего края и растёт вверх ответом. */

PanelPrompt {
    dock: bottom;
    width: 100%;
    height: auto;
    max-height: 60%;
    background: $nex-panel;
    border: round $primary;
    padding: 0 1;
    margin: 0 1 0 1;
}

#pp-header { height: 1; width: 100%; margin-bottom: 1; }
#pp-title { width: 1fr; height: 1; }

/* Крестик — не кнопка с рамкой (это спорило бы с полями ввода вокруг), а
   строка «✕ Esc», которая выделяется только под курсором: так же ведут себя
   чипы. Ширина под подпись, а не только символ: клавишу закрытия должно
   быть видно текстом, а не только всплывающей подсказкой по наведению. */
#pp-close {
    width: 7;
    height: 1;
    content-align: right middle;
    color: $nex-faint;
}
#pp-close:hover {
    color: $nex-title;
    background: $nex-raised;
    text-style: bold;
}

#pp-answer {
    height: auto;
    max-height: 14;
    scrollbar-size-vertical: 1;
}

.pp-line { height: auto; width: 100%; margin-bottom: 1; }

#pp-chips { height: auto; width: 100%; grid-gutter: 0 1; }

.prompt-chip {
    width: 1fr;
    height: 1;
    background: transparent;
    color: $nex-dim;
    margin-right: 1;
}

#pp-field { height: 1; width: 100%; }
#pp-mark { width: 2; height: 1; }

#pp-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}

#pp-input > .input--placeholder { color: $nex-faint; }

/* --- развёрнутые панели АГЕНТА ------------------------------------------ */

#seen-wide, #trace-wide { display: none; height: 1fr; scrollbar-size-vertical: 1; }

#scen-wide { display: none; height: 1fr; width: 100%; }
#scen-head { height: auto; }

#scen-filter-row { height: 1; width: 100%; margin-bottom: 1; }
#scen-filter-label { width: 8; height: 1; color: $nex-faint; }
#scen-filter {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}
#scen-filter > .input--placeholder { color: $nex-faint; }

#scen-table { height: auto; max-height: 60%; background: transparent; }
#scen-table > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}
#scen-table > .datatable--cursor { background: $primary 30%; }
#scen-table > .datatable--hover { background: $nex-raised; }
#scen-foot { height: auto; padding-top: 1; }

#tape-wide, #kern-wide { display: none; height: 1fr; scrollbar-size-vertical: 1; }
