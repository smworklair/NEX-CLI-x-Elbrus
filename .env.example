# Скопировать в .env (файл в .gitignore, НЕ коммитится!) и вписать ключи.
# Без этого файла и без NEX_API_KEY агент работает офлайн: честно говорит,
# что модель недоступна, и отвечает по уже посчитанным числам (vliw.core).
#
# Нужен только ОДИН набор — тот провайдер, которым пользуетесь.
# Провайдер выбирается NEX_PROVIDER (по умолчанию mistral).
# Формат backend'ов — как в Nex-pilot: один интерфейс, по файлу на провайдер
# (vliw/agent/backends/), верхние слои не знают, какой API за ним.

# --- Выбор провайдера ---
# mistral | gemini | openai | deepseek | qwen | kimi | grok | anthropic | glm | muse
#   | openrouter | vercel | local-server | custom | gigachat | yandex | local
NEX_PROVIDER=mistral

# --- Общее (для всех, у кого один ключ) ---
# Сюда же можно положить ключ mistral/gemini/openai/deepseek/qwen/kimi/custom/yandex.
# Для GigaChat сюда кладётся пара "client_id:client_secret" (с двоеточием).
NEX_API_KEY=
# Перебить модель по умолчанию у текущего провайдера (необязательно).
NEX_MODEL=

# --- Mistral / Gemini (как было) ---
# Ключи: https://console.mistral.ai/api-keys | https://aistudio.google.com/apikey
MISTRAL_API_KEY=
GEMINI_API_KEY=

# --- OpenAI-совместимые: OpenAI / DeepSeek / Qwen / Kimi / Vercel ---
# Ключи: https://platform.openai.com/api-keys | https://platform.deepseek.com/api_keys
#        https://bailian.console.aliyun.com/ | https://platform.moonshot.ai/console/api-keys
#        Vercel: дашборд → AI Gateway → API Keys (модели вида openai/gpt-5.4)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
VERCEL_API_KEY=

# --- Рабочие лошадки отдельно: Grok (xAI) / Anthropic / GLM (Z.ai) / Muse (Meta) ---
# Ключи: https://console.x.ai/ | https://platform.claude.com/
#        https://z.ai/manage-apikey/apikey-list | https://ai.developer.meta.com/
XAI_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=
META_API_KEY=

# --- OpenRouter: агрегатор, свой ключ ---
# Взять на https://openrouter.ai/ (модели вида deepseek/deepseek-chat)
OPENROUTER_API_KEY=

# --- Local: свой сервер на этой машине (Ollama / LM Studio / llama.cpp) ---
# Только loopback-адреса. Ключ обычно не нужен (поле можно оставить пустым).
# NEX_LOCAL_URL=http://localhost:11434/v1
# NEX_LOCAL_MODEL=llama3
# NEX_LOCAL_KEY=

# --- custom (legacy): ЛЮБОЙ другой OpenAI-совместимый сервер ---
# Корпоративный шлюз и т.п. — всё, у чего есть POST {NEX_BASE_URL}/chat/completions.
# В каталоге скрыт: для OpenRouter есть openrouter, для локалки — local-server.
# NEX_BASE_URL=https://my-proxy/v1
# NEX_MODEL=mymodel

# --- Сбер GigaChat (РФ) ---
# Взять на https://developers.sber.ru/portal/products/gigachat (OAuth, client_id+secret).
# GIGACHAT_CLIENT_ID=
# GIGACHAT_SECRET=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2

# --- YandexGPT (РФ, Yandex Cloud) ---
# Хватит ОДНОГО: API-ключ (проще) или IAM-токен. Каталог нужен всегда.
# YANDEX_API_KEY=
# YANDEX_IAM_TOKEN=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=yandexgpt
