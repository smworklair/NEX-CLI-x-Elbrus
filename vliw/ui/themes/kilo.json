    "accent2":     { "color": 80,  "attrs": ["bold"] },
    "accent2_soft":{ "color": 73 },

    "success":     { "color": 114 },
    "warning":     { "color": 221 },
    "error":       { "color": 203, "attrs": ["bold"] },

    "banner":      { "color": 154, "attrs": ["bold"] },
    "banner_alt":  { "color": 148 },
    "mountain":    { "color": 240 },
    "snow":        { "color": 252, "attrs": ["bold"] },

    "border":      { "color": 238 },
    "border_hi":   { "color": 154 },
    "title":       { "color": 255, "attrs": ["bold"] },
