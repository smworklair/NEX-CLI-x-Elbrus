# Copy to .env (listed in .gitignore, NEVER committed!) and fill in your keys.
# Without this file and without NEX_API_KEY, the agent works offline: it states
# plainly that no model is available and answers from already computed numbers (vliw.core).
#
# You only need ONE set — for the provider you use.
# Select the provider via NEX_PROVIDER (default: mistral).
# Backend layout follows Nex-pilot: one interface, one file per provider
# (vliw/agent/backends/), and upper layers remain agnostic to the underlying API.

# --- Provider selection ---
# mistral | gemini | openai | deepseek | qwen | kimi | grok | anthropic | glm | muse
#   | openrouter | vercel | local-server | custom | gigachat | yandex | local
NEX_PROVIDER=mistral

# --- Generic (for single-key setups) ---
# You can place a mistral/gemini/openai/deepseek/qwen/kimi/custom/yandex key here.
# For GigaChat, use a "client_id:client_secret" pair (separated by a colon).
NEX_API_KEY=
# Override the default model for the active provider (optional).
NEX_MODEL=

# --- Mistral / Gemini ---
# Keys: https://console.mistral.ai/api-keys | https://aistudio.google.com/apikey
MISTRAL_API_KEY=
GEMINI_API_KEY=

# --- OpenAI-compatible: OpenAI / DeepSeek / Qwen / Kimi / Vercel ---
# Keys: https://platform.openai.com/api-keys | https://platform.deepseek.com/api_keys
#       https://bailian.console.aliyun.com/ | https://platform.moonshot.ai/console/api-keys
#       Vercel: Dashboard -> AI Gateway -> API Keys (models like openai/gpt-5.4)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
VERCEL_API_KEY=

# --- Standalone workhorses: Grok (xAI) / Anthropic / GLM (Z.ai) / Muse (Meta) ---
# Keys: https://console.x.ai/ | https://platform.claude.com/
#       https://z.ai/manage-apikey/apikey-list | https://ai.developer.meta.com/
XAI_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=
META_API_KEY=

# --- OpenRouter: aggregator, own key ---
# Get one at https://openrouter.ai/ (models like deepseek/deepseek-chat)
OPENROUTER_API_KEY=

# --- Local: self-hosted server on this machine (Ollama / LM Studio / llama.cpp) ---
# Loopback addresses only. A key is usually not required (leave blank).
# NEX_LOCAL_URL=http://localhost:11434/v1
# NEX_LOCAL_MODEL=llama3
# NEX_LOCAL_KEY=

# --- custom (legacy): ANY other OpenAI-compatible server ---
# Corporate gateway, etc. — anything supporting POST {NEX_BASE_URL}/chat/completions.
# Hidden in the catalog: use openrouter for OpenRouter and local-server for local servers.
# NEX_BASE_URL=https://my-proxy/v1
# NEX_MODEL=mymodel

# --- Sber GigaChat (RU) ---
# Get credentials at https://developers.sber.ru/portal/products/gigachat (OAuth, client_id+secret).
# GIGACHAT_CLIENT_ID=
# GIGACHAT_SECRET=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2

# --- YandexGPT (RU, Yandex Cloud) ---
# ONE is enough: API key (simpler) or IAM token. Folder ID is always required.
# YANDEX_API_KEY=
# YANDEX_IAM_TOKEN=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=yandexgpt
