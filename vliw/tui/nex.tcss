/* ------------------------------------------------------------------------
   NEX — оформление интерфейса.

   Цвета сюда попадают из палитры проекта (vliw/ui/themes/*.json) через
   переменные $nex-*: одна и та же тема красит и построчный вывод, и этот
   экран. Здесь задаётся только вёрстка и иерархия поверхностей.

   Поверхности:  canvas (полотно) < panel (панель) < raised (активное).
   Акцент ($primary) свой у каждого режима и приходит из темы приложения.
   ------------------------------------------------------------------------ */

Screen {
    /* Слой для подсказки при наборе: она всплывает поверх раскладки и места
       под себя не резервирует. */
    layers: base overlay;
    background: $nex-canvas;
    color: $nex-text;
}

/* --- полосы прокрутки --------------------------------------------------- */
/* Размер 1 — по всей поверхности интерфейса. Дефолт Textual (2 клетки) без
   этого правила торчал у редактора и контейнеров: тёмный столб посреди кода
   и двухрядная полоса под панелью выглядели как сломанная раскладка, а не
   как указатель положения. Цвета полос задаёт тема ($scrollbar-*): фон =
   панель, бегунок чуть светлее — полоса не спорит с содержимым. */
TextArea, VerticalScroll, OptionList, DataTable, RichLog, ItemGrid {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

/* --- шапка режима ------------------------------------------------------ */
/* height auto, а не 1: под основной строкой может стоять вторая — факты
    спящих режимов. Без фактов второй строки нет (display ставит код), и
    шапка во всех режимах остаётся однорядной. */

TopBar {
    dock: top;
    height: auto;
    width: 100%;
    padding: 0 2;
    background: $nex-shadow;
}

#topbar-line { height: 1; width: 100%; }

/* Вторая строка — пилот РАЗБОРА: по одному короткому факту на каждый
    спящий режим (ЯДРО/АГЕНТ/КОД), клик открывает тот режим. */

#topbar-sleep {
    display: none;
    height: 1;
    width: 100%;
}

#topbar-sleep.on { display: block; }

.sleep-sep { width: auto; height: 1; color: $nex-faint; }

.sleep-chip {
    width: auto;
    height: 1;
    color: $nex-dim;
}

.sleep-chip:hover {
    background: $primary 25%;
    color: $nex-title;
    text-style: bold;
}

/* --- док ввода --------------------------------------------------------- */
/* Строка ввода — терминальное приглашение, а не блок-карточка. ОДИН ряд
    текста на фоне полотна, отделённый от вывода волоском сверху. Ни серой
    подложки на всю ширину, ни пустых полос над и под строкой: четыре
    прошлые версии строили строку как «якорь экрана» и получали брусок,
    который спорил с рамками панелей над ним. Приглашение терминала ничем
    не обрамлено — оно приглашение, а не панель. */

#dock {
    dock: bottom;
    height: auto;
    width: 100%;
    background: $nex-canvas;
}

PromptBar {
    height: auto;
    width: 100%;
}

/* 2 ряда: строка текста и волосок сверху. Фокус показывает сама строка:
    волосок густеет в цвет режима, текст в поле чуть светлеет. Подложки нет
    вовсе — полоса цвета $nex-raised под вводом читалась отдельным
    виджетом, «налепленным» на экран. */
#prompt-field {
    height: 2;
    width: 100%;
    margin: 0;
    padding: 0 1;
    background: transparent;
    border-top: solid $nex-line 30%;
}

#prompt-field:focus-within {
    background: transparent;
    border-top: solid $primary 55%;
}

/* Дети — по одной строке. Марка — шеврон «❯» в одну клетку с пробелом:
    плашка «nex» на общем поле была лишней табличкой. */

#prompt-mark {
    width: 2;
    height: 1;
    content-align: left middle;
}

#prompt-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}

#prompt-input > .input--placeholder {
    color: $nex-faint;
    text-style: none;
}

#prompt-side {
    width: auto;
    height: 1;
    padding: 0 1;
    content-align: right middle;
}

HintBar {
    height: 1;
    width: 100%;
    padding: 0 2;
    background: $nex-shadow;
}

/* --- палитра команд ---------------------------------------------------- */

Palette {
    max-height: 12;
    height: auto;
    width: 100%;
    background: $nex-panel;
    border: none;
    border-left: thick $primary;
    padding: 0;
    scrollbar-size-vertical: 1;
}

Palette > .option-list--option-highlighted {
    background: $primary 25%;
    color: $nex-title;
    text-style: bold;
}

/* --- панели ------------------------------------------------------------ */

/*
   ОКНО — одна строка шапки и содержимое под ней. Ни рамок, ни скруглений.

   Раньше панель была боксом в округлой рамке с именем капсом в бордюре, и
   на экране таких боксов шесть-семь. Стоило это двух строк высоты на каждый
   (верх и низ) и двух колонок ширины, то есть на семи панелях — четырнадцати
   строк экрана под одни бордюры. Но дороже места было другое: КОД к тому
   моменту переехал на плоские окна с однострочной шапкой, и переход из него
   в АГЕНТ читался как переход в другую программу. Двойной клик по вкладке
   теперь водит между ними постоянно — разнобой стало видно на каждом жесте.

   Шапка — не `border_title`, а виджет `.panel-head` первой строкой (см.
   PanelHead в widgets.py): у надписи, врезанной в рамку, нет подложки, а
   окна КОДа подписаны полосой на своём фоне. Границ у окна нет вовсе —
   соседние окна разделяет волосок контейнера-колонки, а окна друг под
   другом уже разделены полосой шапки.
*/
Panel {
    border: none;
    background: transparent;
    padding: 0;
    height: 1fr;
}

/* Содержимое отступает на клетку от края окна — ровно как во вкладках дока
   КОДа. Шапка сюда не попадает: у неё свой padding, а класс в CSS Textual
   сильнее типа. */
Panel > * { padding-left: 1; }

/* Волосок между колонками — там, где два окна встречаются. Обводить окно со
   всех сторон незачем: у края экрана граница не нужна, а окна друг под
   другом уже разделены полосой шапки. */
#mind-right, #lab-right, #core-right { border-left: vkey $nex-line; }

/* Шапка окна — полоса в одну строку. Фон рисуется и под padding, поэтому
   подложка идёт во всю ширину окна, а текст отступает на клетку. */
.panel-head {
    height: 1;
    width: 100%;
    background: $nex-panel;
    text-style: bold;
    padding: 0 1;
}

/* Активное окно помечается ШАПКОЙ, а не цветной рамкой: рамки больше нет,
   а знать, где фокус, надо по-прежнему. */
Panel:focus-within > .panel-head { background: $nex-raised; }

/* --- инструменты панели -------------------------------------------------- */
/* Полоса инструментов живёт ПЕРВЫМ ребёнком панели и видна ВСЕГДА, а не
    только в развороте: «прогнать», «переписать по оракулу», фильтры и
    навигация — основные действия панели, прятать их за двойной клик
    значило бы прятать саму функциональность. Разворот добавляет колонки
    и место, а не открывает базовые кнопки. */

PanelToolbar {
    display: block;
    /* auto, а не 1: лишние чипы уходят второй строкой (см. PanelToolbar),
       а фиксированная единица их обрезала бы вместе с переносом. */
    height: auto;
    width: 100%;
    /* Контентные треки вместо 1fr: иначе колонки тянутся на всю ширину
       и чипы разъезжаются с дырами (видно в широкой панели GIT). */
    grid-columns: auto;
}

/* Марджин чипа — ВНЕ трека не живёт: грид считает его внутрь колонки,
   и каждый чип ужимался ровно на клетку («решётка ▶» читалась как
   «решётка»). Зазор между чипами при этом никуда не девается: у чипа
   паддинг 0 1 с обеих сторон, соседние дают две пустые клетки. Правило
   только для тулбара — у вкладок дока (DockTabs, обычный Horizontal)
   марджин как был, так и нужен. */
PanelToolbar Tool { margin-right: 0; }

/* Тесный экран (80 колонок): дубли-чипы прячутся, тулбар остаётся одной
   строкой. Без этого перенос добавлял правой колонке строки, которых нет
   в бюджете высоты, — МАШИНА уезжала за нижний край молча (ловит
   TestNothingFallsBelowTheFold). Клавиатурные пути те же: чипы — только
   мышиная affordance, действия доступны как были. */
ModeScreen.tight .tb-spare { display: none; }

Tool {
    height: 1;
    width: auto;
    padding: 0 1;
    margin-right: 1;
    background: $nex-raised;
    color: $nex-dim;
}

Tool:hover {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

Tool.tool-on {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

/* Развёрнутая панель занимает всё место между шапкой и доком ввода — чем
   бы ни была её обычная высота. Textual вешает класс `-maximized` на
   развёрнутый виджет, но собственная высота панели никуда не девается: у
   половины панелей она задана числом по id (#p-console: 10, #p-detail: 9,
   #p-seen: 12), и по специфичности id побеждает класс. Получалась узкая
   полоска посреди пустого экрана вместо разворота.
   1fr, а не 100%: со 100% панель накрывала док ввода с полосой подсказок —
   в «полного экрана» пропадала нижняя панель, и выход из разворота
   превращался в угадайку. 1fr честно занимает остаток: шапка, строка
   ввода и подсказки видны всегда.
   `!important` здесь по делу: развёрнутое состояние обязано перебивать
   любую обычную раскладку. */
Panel.-maximized {
    height: 1fr !important;
    max-height: 100% !important;
    min-height: 0 !important;
    width: 100% !important;
}

/* Развёрнутая панель с чатом уступает ему треть ширины. Панель остаётся
   слева: читают её, а спрашивают о прочитанном. */
/* 1fr, а не проценты: чат пристыкован справа, и панель должна занять ровно
   остаток. С процентами она вставала бы по центру, оставляя пустые поля с
   обеих сторон. */
Panel.-maximized.with-chat {
    width: 1fr !important;
}

/* Без layer: слой висит ПОВЕРХ раскладки и места под себя не резервирует —
   панель оставалась во всю ширину, а чат её перекрывал. Обычный dock
   отбирает свою долю честно. */
PanelChat {
    width: 34%;
    height: 100%;
    background: $nex-panel;
    border: round $primary;
    border-title-align: left;
    padding: 0 1;
}

PanelChat.right { dock: right; }

/* У панелей со своей строкой ввода чат встаёт слева: справа уже занято их
   собственным вводом, и два поля рядом путают, куда печатать. */
PanelChat.left { dock: left; }

#pchat-log {
    height: 1fr;
    overflow-y: auto;
}

#pchat-input {
    dock: bottom;
    border: none;
    border-top: solid $nex-line;
    background: transparent;
    height: 2;
}

Console {
    background: transparent;
    scrollbar-size-vertical: 1;
    padding: 0;
}

/* --- ЯДРО: верстак интерпретатора -------------------------------------- */

#core-body {
    height: 1fr;
    width: 100%;
}

#core-left {
    width: 1fr;
    height: 100%;
}

#core-right {
    width: 42;
    height: 100%;
}

#p-tape { height: 1fr; }

#p-kernels {
    height: 4;
    padding: 0 1;
}

#kernel-chips, #verb-chips {
    height: 1;
    width: 100%;
}

.chip-label {
    width: 6;
    height: 1;
    color: $nex-faint;
}

#p-names { height: 1fr; min-height: 6; }
#p-mem   { height: 7; }
#p-prog  { height: 2fr; min-height: 8; }

/* Лист ЛЕНТЫ — главный вид: история строк человека с итогом каждой.
    Строки кликабельны (связка с ПРОГРАММОЙ), отчёт slash-команды живёт
    в консоли ПОД листом и показывается, пока отчёт свежий. */
#tape-sheet {
    height: 1fr;
    width: 100%;
    scrollbar-size-vertical: 1;
}

.tape-row {
    height: auto;
    width: 100%;
    padding: 0 1;
}

.tape-row:hover { background: $nex-raised; }
.tape-row.on { background: $primary 18%; }

.tape-report { padding: 0 1 0 3; }

.tape-empty { height: auto; width: 100%; padding: 0 1; }

#p-tape #console {
    height: 8;
    scrollbar-size-vertical: 1;
    border-top: solid $nex-line 30%;
}

.chip {
    height: 1;
    width: auto;
    padding: 0 1;
    margin-right: 1;
    background: $nex-raised;
    color: $nex-dim;
}

.chip:hover {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

.chip-kernel { color: $nex-accent-soft; }

/* --- РАЗБОР: расписание, которое можно потрогать ------------------------ */
/* Расписание — главный блок экрана, и высоты остальных панелей держатся
    нарочно малыми: УЧАСТОК — полоса чипов, «почему здесь» и вывод команд —
    узкие окна. Всё освободившееся забирает решётка (#p-grid, 1fr). */

#lab-body { height: 1fr; width: 100%; }
#lab-left { width: 1fr; height: 100%; }
#lab-right { width: 46; height: 100%; }

#p-scen {
    height: auto;
    max-height: 5;
    padding: 0 1;
}

#view-chips { height: auto; width: auto; }
#scenario-chips { height: auto; width: 100%; grid-gutter: 0; }

/* Строка над решёткой: слева переключатель вида, справа живой счёт. */
#grid-head { height: 1; width: 100%; }
#grid-hud {
    width: 1fr;
    height: 1;
    content-align: right middle;
    color: $nex-dim;
}

/* Разворот решётки: слева решётка, справа инспектор. Рамка и отступ —
    чтобы колонка читалась отдельной панелью со своими секциями
    (КУРСОР / НАХОДКА / КАНАЛЫ / КЛАВИШИ), а не пустотой рядом. */
#grid-main { height: 1fr; width: 100%; }

#grid-side {
    display: none;
    width: 44;
    height: 100%;
    border-left: vkey $nex-line;
    padding: 0 0 0 1;
    background: $nex-panel;
}

Panel.-maximized #grid-side { display: block; }

.chip-view { color: $nex-dim; }

.chip-on {
    background: $primary 30%;
    color: $nex-title;
    text-style: bold;
}

.chip-scen {
    width: 1fr;
    margin-right: 1;
    background: transparent;
    color: $nex-dim;
}

#p-grid { height: 1fr; min-height: 8; }

/* GIT повыше, чем было (7): полоска в две строки вывода читалась как
    обрезок, а не как панель. Внутри — командная строка-чип, высота
    включает и её три строки. */
#p-console { height: 12; }

/* Командная строка внутри GIT — чип с круглой рамкой в цвет ПАНЕЛИ:
    контура нет (шов со стенкой не читается), середина остаётся
    приподнятой подложкой со скруглёнными краями. В фокусе проявляется
    приглушённый акцентный контур и подсветка фона. Тот же PromptBar:
    палитра по «/», история, «считаю…». */
#p-console #prompt { height: auto; width: 100%; }

/* Строка ввода ВНУТРИ панели — часть панели, а не карточка на ней.
   Была коробка: своя подложка плюс `border: round`, и всё это внутри
   панели, у которой рамка уже есть. Две вложенные рамки читаются как
   «интерфейс из отдельных кусков», особенно когда внешняя подсвечена
   фокусом. Теперь поле лежит на той же поверхности и отделено сверху
   волоском; фокус меняет ТОН волоска и подложку на едва заметную, а не
   обводит вторую рамку. */
/* В панели GIT та же терминальная строка, что в доке: один ряд, волосок
    сверху, фокус — густеющий волосок. Раньше здесь стоял отдельный
    «плоский чип» — панель читалась как интерфейс из разных кусков. */
#p-console #prompt-field {
    height: 2;
    margin: 0;
    padding: 0 1;
    background: transparent;
    border: none;
    border-top: solid $nex-line 30%;
}

#p-console #prompt-field:focus-within {
    background: transparent;
    border: none;
    border-top: solid $primary 55%;
}

#p-console #prompt-side { padding: 0 1; }

/* Подсказка в пустом поле чуть живее «faint»: это приглашение к набору,
    а не вывод, который можно пролистать не читая. */
#p-console #prompt-input > .input--placeholder {
    color: $nex-dim;
}

/* Палитра по «/» — внутри панели места впятеро меньше, чем было у дока:
    без потолка она вытесняла само поле ввода за нижний край панели.
    Список прокручивается, полный каталог — в развёрнутом GIT. */
#p-console Palette {
    max-height: 5;
    scrollbar-size-vertical: 1;
}

#grid {
    background: transparent;
    height: 1fr;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

/* Мостик под решёткой к развёрнутому ДИАГНОЗУ. `display: none` — не
   украшение, а обязательство: в обычном виде он отбирал у расписания целую
   строку (было видно до т.21, стало до т.20), то есть платил главным окном
   инструмента за подсказку, которая нужна только развёрнутой решётке.
   Показывается из кода ровно на время разворота. */
#grid-link {
    display: none;
    height: 1;
    padding: 0 1;
}

#grid-link.on { display: block; }

/* --- ДИАГНОЗ: полный список находок при развороте ---------------------- */

#diag-filter {
    height: auto;
    width: 100%;
    /* Без зазора список находок стартовал вплотную под фильтром — та же
       рамка сверху и снизу читалась одной слипшейся полосой. У соседнего
       #machine-filter-row тот же приём уже стоит. */
    margin-bottom: 1;
}

.diag-sev {
    width: auto;
}

.finding-row {
    height: auto;
    width: 100%;
    margin-bottom: 1;
    padding: 0 1;
}

.finding-row:hover {
    background: $nex-raised;
}

/* Находка про клетку под курсором. Не заливка на всю ширину — она читалась
   как отдельный блок и спорила с рамкой панели, — а полоса слева: тот же
   приём, что у цитаты в тексте. */
.finding-row.here {
    border-left: thick $primary;
    padding-left: 1;
}

#diag-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#grid > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}

#grid > .datatable--cursor {
    background: $primary 35%;
    color: $nex-title;
}

#grid > .datatable--hover {
    background: $nex-raised;
}

/* ДИАГНОЗ свёрнут до строки-сводки: подробности дублируют решётку
    (простой виден строкой, находка под курсором — в инспекторе разворота),
    панель держит только «сколько проблем и какая хуже». Полный список —
    по 2×клику или клавише d из решётки. */
/* Правая колонка обязана помещаться ЦЕЛИКОМ: ЧИСЛА и «ПОЧЕМУ ЗДЕСЬ» —
    по содержимому, но с потолком; длинный разбор и ответ ИИ прокручиваются
    внутри панели, а не распирают её и не уносят МАШИНУ за нижний край.
    ДИАГНОЗ забирает остаток. Разворот снимает потолки: -maximized идёт
    с !important. */
/* Правая колонка РАЗБОРА делит высоту, а не занимает сколько выросло.
   Раньше `#p-detail` был `auto` без потолка: разбор длинный — и панели под
   ним уезжали за нижний край вместе с матрицей портов. Теперь остаток
   забирает он (внутри у него свой VerticalScroll, так что содержимое не
   теряется), а нижние панели держат свои размеры. */
#p-numbers  { height: auto; max-height: 12; }
#p-detail   { height: 1fr; min-height: 6; }
#p-diag     { height: auto; min-height: 4; max-height: 8; }
#p-machine  { height: auto; min-height: 6; max-height: 9; }

/* Невысокий терминал: ужимаем нижние панели, разбор ужимается сам как 1fr. */
ModeScreen.low #p-numbers { max-height: 8; }
ModeScreen.low #p-diag    { min-height: 3; max-height: 5; }
ModeScreen.low #p-machine { min-height: 4; max-height: 6; }
ModeScreen.low #p-detail  { min-height: 4; }

ModeScreen.very-low #p-numbers { max-height: 6; }
ModeScreen.very-low #p-diag    { min-height: 3; max-height: 4; }
ModeScreen.very-low #p-machine { min-height: 3; max-height: 4; }

/* Содержимое панели МАШИНА — сводка профиля. У неё нет своей прокрутки, и
   на очень низком терминале она вылезала из панели, которую сама же и
   переросла. Потолок по месту в панели: строки, которые не влезли, читаются
   через `/model`, о чём в панели и написано. */
#machine { height: auto; max-height: 100%; overflow-y: hidden; }
ModeScreen.very-low #p-detail  { min-height: 3; }

#detail-scroll {
    height: auto;
    max-height: 12;
    scrollbar-size-vertical: 1;
}

/* Развёрнутый разбор забирает всю высоту панели, а не 12 строк. */
#p-detail.-maximized #detail-scroll { height: 1fr; max-height: 100%; }

/* --- АГЕНТ: диалог, у которого видно основание -------------------------- */

#mind-body { height: 1fr; width: 100%; }
#mind-left { width: 1fr; height: 100%; }
#mind-right { width: 42; height: 100%; }

#p-chat { height: 1fr; }

/* Развёрнутый ДИАЛОГ: слева история вопросов (шириной как журнал запусков),
   справа лента. Колонку включает код при развороте — тот же приём со слоями,
   что и у остальных панелей: рисование зависит от режима, а не от размера. */
#chat-body { width: 100%; height: 100%; }

#chat-hist-col {
    display: none;
    width: 46;
    height: 100%;
    border-right: solid $nex-line 35%;
    padding-right: 1;
}

#chat-hist {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

.hist-item {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.hist-item:hover { background: $nex-raised; }
#p-questions { height: auto; max-height: 6; padding: 0 1; }
#question-chips { height: auto; width: 100%; }

.chip-question {
    width: 1fr;
    margin-right: 1;
    background: transparent;
    color: $nex-mind-soft;
}

#chat {
    height: 100%;
    width: 1fr;
    scrollbar-size-vertical: 1;
}

.msg-you {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.msg-mark { height: 1; width: 100%; }

.msg-nex {
    height: auto;
    width: 100%;
    padding-left: 2;
    margin-bottom: 1;
}

.msg-note {
    height: auto;
    width: 100%;
    color: $nex-dim;
    margin-bottom: 1;
}

#p-seen  { height: 10; }
#p-trace { height: 1fr; min-height: 6; }
#p-mind-console { height: 8; }

/* --- узкое окно --------------------------------------------------------- */

ModeScreen.narrow #core-right,
ModeScreen.narrow #lab-right { width: 40; }
ModeScreen.narrow #mind-right { width: 38; }

ModeScreen.narrow #p-console { height: 11; }
ModeScreen.narrow #p-mind-console { height: 6; }
ModeScreen.narrow #p-seen { height: 9; }

ModeScreen.tight #core-right,
ModeScreen.tight #lab-right,
ModeScreen.tight #mind-right { width: 34; }

ModeScreen.tight #p-kernels,
ModeScreen.tight #p-scen,
ModeScreen.tight #p-questions { display: none; }

ModeScreen.tight #p-console { height: 8; }

/* --- КОД: редактор, нижний док, строка состояния ----------------------- */
/*
   Один экран и пристыкованные окна — по образцу IDE.

       шапка режима                                  1
       полоса файлов                                 1
       РЕДАКТОР                                      всё остальное
       ───────── волосок ─────────
       вкладки: расписание │ разбор │ замечания │ вывод
       содержимое вкладки                            ~треть
       строка состояния                              1
       подсказки клавиш                              1

   Снизу ОДНО окно, а не два. Пока их было два — расписание отдельной
   панелью и выдвижной ящик под ней, — редактор оказывался самой маленькой
   областью экрана (одиннадцать строк кода из сорока двух), а строка
   состояния висела МЕЖДУ ними, посреди экрана.

   Рамок нет. Три панели в рамках стоили шесть строк на одни бордюры и
   печатали имена капсом там, где место нужно содержимому: имя вкладки уже
   написано в полосе вкладок. Разделителей ровно два — волосок над доком и
   подложка строки состояния.
*/

#code-head {
    height: 1;
    width: 100%;
    background: $nex-shadow;
}


#code-body { height: 1fr; width: 100%; }

/* Каталог слева: примеры машины и настоящий код репозитория. ЗАКРЫТ по
   умолчанию — ^B открывает. Открытым он отбирал у кода двадцать колонок
   навсегда, чтобы показать восемь имён и полтора экрана пустоты под ними;
   нужен он ровно дважды — в первую минуту и когда открываешь второй файл.
   Волосок справа вместо рамки: колонка отделена, а не обведена. */
#code-side {
    display: none;
    width: 22;
    height: 100%;
    border-right: vkey $nex-line;
}

/* Список файлов под шапкой: прокручивается он, шапка стоит. */
#code-side-list {
    height: 1fr;
    width: 100%;
    padding: 0 0 0 1;
    scrollbar-size-vertical: 1;
}

.side-item { height: 1; width: 100%; }
.side-item:hover { background: $primary 20%; }
/* Строка под выделением в проводнике: по ней ходят стрелками, и Enter
   откроет именно её. Без пометки клавиатурная навигация вслепую. */
.side-item-on { background: $primary 30%; text-style: bold; }

/* Колонки агента справа больше нет: она показывала тот же разговор, что
   вкладка АГЕНТ нижнего дока (см. CodeScreen.compose). Её место занял
   ПРОВОДНИК — тоже закрытый по умолчанию: постоянная колонка папок отбирала
   бы ширину у планировщика, ради которого экран и открывают. */
#code-explorer {
    display: none;
    width: 30;
    height: 100%;
    border-left: vkey $nex-line;
}

#explorer-search { height: 1; width: 100%; }
#explorer-mark { width: 3; height: 1; color: $accent; }
#explorer-find {
    width: 1fr;
    height: 1;
    border: none;
    background: transparent;
}

#explorer-list {
    height: 1fr;
    width: 100%;
    /* Отступ в клетку — как у содержимого остальных окон. Без него список
       прижимался вплотную к волоску-разделителю и выглядел приклеенным к
       редактору. */
    padding: 0 0 0 1;
    scrollbar-size-vertical: 1;
}

/* Прятать колонки правилом нельзя: их показывает inline-стиль, а он
   сильнее таблицы стилей. Этим занимается CodeScreen._fit_columns —
   там же считается, сколько клеток обязано остаться редактору. */

/* Первый экран поверх редактора: слой overlay, потому что печатать человек
   должен сразу, а не после того, как уберёт приветствие. Ширину не берёт —
   у слоя её нет; высоту тоже. */
#code-hello {
    display: none;
    layer: overlay;
    width: 64;
    height: auto;
    offset: 12 2;
    background: $nex-panel;
    padding: 0 2 1 0;
}

#code-edit {
    height: 1fr;
    /* 1fr, а не 100%: слева от редактора может встать колонка примеров. */
    width: 1fr;
    border: none;
    padding: 0 0 0 1;
    background: transparent;
    color: $nex-text;
}

#code-edit:focus { border: none; background: transparent; }
#code-edit > .text-area--cursor-line { background: $primary 10%; }

/* --- нижний док -------------------------------------------------------- */
/*
   Треть экрана — столько же, сколько у инструментального окна в любой IDE:
   хватает читать, но рабочая область остаётся главной. Волосок сверху —
   единственная граница; заголовка у дока нет, его имя написано на активной
   вкладке.
*/

/* min-height 10 — не «на глаз», а по решётке: волосок сверху (1), полоса
   вкладок (1), шапка тактов (1), ШЕСТЬ каналов (6) и полоса горизонтальной
   прокрутки (1). Шесть каналов обязаны быть видны целиком: обрезанный
   шестой — это ,5, тот самый монопольный делитель, и без него решётка
   перестаёт отвечать на свой вопрос. При min-height 8 на терминале 80x24
   ,5 уезжал за нижний край молча. */
#code-dock {
    /* Стартовое значение; настоящую высоту ставит экран под открытую
       вкладку либо человек — мышью за границу. См. CodeScreen.TAB_HEIGHT. */
    height: 12;
    min-height: 5;
    width: 100%;
    /* Канвас, а не панель: док был единственной светлой плитой на экране
       (редактор, колонки и подвал — все тёмные) и читался инородным окном
       поверх чужой программы. Границей остаются волосок сверху и чипы
       вкладок — плите для этого быть светлой не нужно. */
    background: $nex-canvas;
}

/* Граница редактор/док — ручка, за которую тянут. Подсветка под курсором
   говорит, что за неё можно взяться: в терминале форму курсора не сменить,
   и это единственный способ показать, что строка живая. */
#dock-split {
    height: 1;
    width: 100%;
    color: $nex-line;
}

#dock-split:hover { color: $primary; background: $primary 20%; }

#dock-tabs { height: 1; width: 100%; background: $nex-canvas; padding: 0 1; }
#dock-sep { width: auto; height: 1; color: $nex-line; margin: 0 1; }
#dock-note { height: 1; width: 1fr; content-align: right middle; padding: 0 1; }

/* --- вкладка РАСПИСАНИЕ ------------------------------------------------ */

#dock-sched { height: 1fr; width: 100%; }
#code-grid-wrap { width: 1fr; height: 100%; padding: 0 0 0 1; }
#code-grid-orc-wrap { display: none; width: 1fr; height: 100%; }
/* auto, а не 1: пока точного поиска нет, здесь стоит приглашение его
   посчитать — три строки вместо пустой половины экрана. */
#code-grid-orc-head { height: auto; width: 100%; }

#code-grid, #code-grid-orc {
    background: transparent;
    height: 1fr;
    width: 100%;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

#code-grid > .datatable--header, #code-grid-orc > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}

#code-grid > .datatable--cursor, #code-grid-orc > .datatable--cursor {
    background: $primary 30%;
    color: $nex-title;
}

/* Разбор решётки: загрузка портов и «что переставить». Виден ТОЛЬКО в
   развороте дока (F11).

   Раньше стоял всегда и отбирал у решётки треть ширины. На 34 колонках его
   строки переносились («т12 → т5,» / «канал ,4»), то есть место он занимал,
   а читаться переставал. И главное — список перестановок целиком лежит во
   вкладке ЗАМЕЧАНИЯ: одно и то же в двух вкладках сразу это не два ответа,
   а один лишний вопрос «это то же самое или другое?». */
#sched-side {
    display: none;
    width: 46;
    height: 100%;
    border-left: vkey $nex-line;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#sched-side-body { height: auto; width: 100%; }

/* --- вкладка РАЗБОР ---------------------------------------------------- */
/*
   Была отдельным РЕЖИМОМ и отдельной колонкой разворота редактора — два
   места под один и тот же углублённый просмотр того, что уже на экране.
   Теперь одна вкладка в две колонки: слева такт под курсором и его цепочка
   зависимостей, справа каталог всех тактов буфера.
*/

#dock-line { height: 1fr; width: 100%; }

/* Числа и машина — только в развороте РАЗБОРА (см. CodeScreen.compose). */
#line-side {
    display: none;
    width: 38;
    height: 100%;
    padding: 0 1;
    border-left: vkey $nex-line;
    scrollbar-size-vertical: 1;
}
#line-side-body { width: 100%; height: auto; }
ModeScreen.zoom-dock #line-side { display: block; }
ModeScreen.tight #line-side { display: none; }

#dock-line-col {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#code-line-info, #code-chain-body { height: auto; width: 100%; }

#dock-bundles {
    width: 46;
    height: 100%;
    border-left: vkey $nex-line;
    scrollbar-size-vertical: 1;
}

/* --- вкладки ЗАМЕЧАНИЯ и ВЫВОД ----------------------------------------- */

#sched-empty { display: none; height: 1fr; width: 1fr; padding: 1 1 0 1; }

#dock-lint { height: 1fr; width: 100%; scrollbar-size-vertical: 1; }
#dock-term { height: 1fr; width: 100%; }

/* Строка ввода внутри ВЫВОДА — одна строка текста, как приглашение
   терминала. Трёхрядным полем с отступами она была, пока стояла в доке и
   была главным элементом экрана; здесь она просто последняя строка вывода.

   height: 2, а не 1. У Textual box-sizing по умолчанию border-box, то есть
   высота считается ВМЕСТЕ с рамкой: при height:1 волосок сверху съедал
   единственную строку содержимого, и поле ввода становилось невидимым. ^P
   фокусировал строку, которой на экране нет, — набирать команду
   приходилось вслепую. Тот же расчёт у #prompt-field выше по файлу: там
   с самого начала стоит 2. */
#dock-term #prompt-field {
    height: 2;
    margin: 0;
    padding: 0 1;
}

#dock-term #console { height: 1fr; }

/* --- вкладка ЯДРО: консоль интерпретатора ------------------------------ */
/*
   Аналог Python Console в IDE: лента ответов, строка ввода под ней и
   панелька состояния машины справа. Целого экрана эта работа не стоит —
   её ценность в одном: собрать граф выражениями, не умея писать ассемблер.
*/

#dock-core { height: 1fr; width: 100%; }

/* Готовые ядра и глаголы — только в развороте (см. CodeScreen.compose). */
/* Сеткой, а не строкой: ядер одиннадцать, и в одну строку они уезжают за
   край — первым пропадает то, что дальше от начала алфавита, без всякой
   причины. Сетка переносит и держит не больше трёх строк. */
#core-chips {
    display: none;
    height: auto;
    max-height: 3;
    width: 100%;
    padding: 0 1;
}
ModeScreen.zoom-dock #core-chips { display: block; }
/* Панель состояния машины в развороте шире: там она показывает имена,
   память и накопленный граф целиком, а не первые строки. */
ModeScreen.zoom-dock #core-state-col { width: 44; }

/* Вкладка АГЕНТ: лента переписки и строка вопроса под ней. Та же переписка,
   что в колонке справа (`session.dialog`), но во всю ширину дока.

   Всё, чего в свёрнутом виде нет, спрятано ЗДЕСЬ, а не в коде: развёрнутый
   блок добавляет колонку фактов и трассы, готовые вопросы и свои кнопки.
   Полный экран — это больше инструментов, а не тот же блок покрупнее. */
#dock-agent { height: 1fr; width: 100%; }
#agent-main { height: 1fr; width: 1fr; }
#agent-log-box { height: 1fr; width: 100%; scrollbar-size-vertical: 1; }
#agent-log { width: 100%; height: auto; padding: 0 1; }
/* Строка вопроса пристыкована к низу блока: между лентой и ней в развороте
   встают готовые вопросы, и без dock она уезжала за край — поле ввода
   пропадало ровно в том виде, где спрашивают чаще всего. */
#agent-prompt { height: 1; width: 100%; dock: bottom; }
#agent-mark { width: 3; height: 1; color: $accent; }
#agent-input { width: 1fr; height: 1; border: none; background: transparent; }

#agent-tools { display: none; height: 1; width: 100%; padding: 0 1; }
/* Готовые вопросы видны ВСЕГДА: в свёрнутой вкладке они занимали место
   ничем (четыре строки из тринадцати), а вопрос «о чём его вообще
   спрашивать» стоит первым у всякого, кто открыл агента. В развороте их
   больше — там и места больше. */
#agent-asks { height: auto; max-height: 2; width: 100%; padding: 0 1; }
ModeScreen.zoom-dock #agent-asks { max-height: 4; }
#agent-side {
    display: none;
    width: 40;
    height: 100%;
    padding: 0 1;
    border-left: vkey $nex-line;
    scrollbar-size-vertical: 1;
}
#agent-seen, #agent-trace { width: 100%; height: auto; }

ModeScreen.zoom-dock #agent-tools { display: block; }
ModeScreen.zoom-dock #agent-side { display: block; width: 46; }
/* В узком окне колонка фактов уступает ленте: ответ важнее справки. */
ModeScreen.narrow #agent-side { width: 30; }
ModeScreen.tight #agent-side { display: none; }
#core-log-box { width: 1fr; height: 100%; }

#core-log {
    height: 1fr;
    width: 100%;
    background: transparent;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

/* Строка ввода — одна строка с шевроном, как приглашение терминала.
   height: 2 — это строка плюс волосок над ней (box-sizing: border-box). */
#core-prompt {
    height: 2;
    width: 100%;
    border-top: solid $nex-line 30%;
}

#core-prompt:focus-within { border-top: solid $primary 55%; }
#core-mark { width: 3; height: 1; padding: 0; color: $nex-faint; }

#core-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}

#core-input > .input--placeholder { color: $nex-faint; text-style: none; }

#core-state-col {
    width: 30;
    height: 100%;
    padding: 0 1;
    border-left: vkey $nex-line;
    scrollbar-size-vertical: 1;
}

#core-state { height: auto; width: 100%; }

/* Замечание — не абзац текста, а ссылка: клик ведёт курсор на строку. */
.lint-item { height: auto; width: 100%; }
.lint-item:hover { background: $primary 20%; }

/* --- подвал: ОДНА строка состояния, в самом низу ----------------------- */

#code-foot { dock: bottom; height: auto; width: 100%; }

#code-status-row { height: 1; width: 100%; background: $nex-shadow; }

#code-line-chip {
    width: auto;
    min-width: 24;
    height: 1;
    padding: 0 1 0 0;
}

#code-line-chip:hover { background: $primary 25%; }

#code-keys { width: auto; height: 1; padding: 0 2 0 1; }

#code-status { width: 1fr; height: 1; content-align: right middle; padding: 0 2 0 0; }

/* Пункты-лаунчеры в строке состояния: ошибки и вывод. Вид — как у обычного
   текста строки состояния, кликабельность проявляется наведением, как у
   ссылок: строка состояния в IDE не должна выглядеть кнопочной панелью. */
#status-lint, #status-term {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $nex-dim;
}

#status-lint:hover, #status-term:hover {
    background: $primary 25%;
    color: $nex-title;
    text-style: bold;
}

/* --- узкое и низкое окно ------------------------------------------------ */
/*
   Панели независимы: то, чему не хватило места, убирается целиком, а не
   ужимается до нечитаемого. Первой уходит колонка разбора у решётки —
   решётка отвечает на главный вопрос вкладки и обязана остаться.
*/

ModeScreen.narrow #dock-bundles { width: 38; }
ModeScreen.tight #dock-bundles { display: none; }
ModeScreen.tight #sched-side { display: none; }
ModeScreen.narrow #core-state-col { width: 26; }
ModeScreen.tight #core-state-col { display: none; }

/* Каталог слева уходит первым: он вход в работу, а не сама работа, и
   открыть пример можно командой /example. Двадцать колонок из восьмидесяти
   — четверть экрана под список из десяти имён. */
/* См. выше: ширину колонок решает _fit_columns, а не класс .tight. */

/* Низкий терминал: доку хватает восьми строк по min-height, но процент от
   него отбирает у кода больше, чем стоит. Ниже 34 строк док становится
   фиксированной полосой, а всё, что осталось, достаётся редактору. */
ModeScreen.low #code-dock { height: 11; }
ModeScreen.very-low #code-dock { height: 10; }

/* Разворот дока: полэкрана вкладке, остальное коду. Редактор не прячется
   никогда — иначе непонятно, к чему относится то, что в доке. */
/* Разворот дока — НА ВЕСЬ экран, а не на две трети. «Полноэкранный режим»,
   который отдаёт 65%, читается как поломка: человек жмёт дважды и видит, что
   панель выросла, но код всё равно занимает треть. Симметрично с двойным
   кликом по вкладке файла, который убирает всё вокруг редактора. */
ModeScreen.zoom-dock #code-body { display: none; }
ModeScreen.zoom-dock #dock-split { display: none; }
/* 1fr, а не 100%: сотня процентов считается от ЭКРАНА, и развёрнутый док
   уезжал под строку состояния — вместе с ней пропадала строка вопроса
   агента, то есть ровно то, ради чего его разворачивают. */
ModeScreen.zoom-dock #code-dock { height: 1fr; }
ModeScreen.zoom-dock #code-grid-orc-wrap { display: block; }
/* Разворот ДОБАВЛЯЕТ: в две трети экрана помещается и разбор решётки. */
ModeScreen.zoom-dock #sched-side { display: block; }

/* --- подсказка при наборе ---------------------------------------------- */
/*
   Всплывает под курсором, поверх раскладки. Слой `overlay` обязателен:
   обычный виджет отобрал бы место у редактора, а подсказка живёт доли
   секунды и место занимать не должна.
*/

Suggest {
    display: none;
    layer: overlay;
    width: 52;
    height: auto;
    max-height: 9;
    background: $nex-raised;
    border: round $primary;
    padding: 0;
}

.suggest-item { height: 1; width: 100%; }
.suggest-item:hover { background: $primary 25%; }
.suggest-on { background: $primary 35%; text-style: bold; }

/* --- выбор режима ------------------------------------------------------ */

#picker-wrap {
    align: center middle;
    height: 1fr;
    width: 100%;
}

#picker-logo {
    height: auto;
    width: auto;
    margin-bottom: 1;
}

#picker-tagline {
    height: auto;
    width: auto;
    text-align: center;
    margin-bottom: 2;
}

#picker-cards {
    width: 78;
    height: auto;
    align-horizontal: center;
}

.mode-card {
    height: 6;
    width: 100%;
    padding: 0 2;
    margin-bottom: 1;
    background: $nex-panel;
    border: round $nex-line;
}

.mode-card.selected {
    background: $nex-raised;
}

.mode-card:hover {
    background: $nex-raised;
}

#picker-hint {
    height: 1;
    width: auto;
    margin-top: 1;
}

/* Тесно по высоте — ужимаемся ровно настолько, насколько не хватает.
   Порядок жертв от дешёвой к дорогой: отступы, высота карточек, знак NEX,
   подпись. Карточки не прячем никогда: без них экран теряет смысл.
   Знак убирается ПОСЛЕДНИМ, а не первым: он занимает восемь строк, и
   прятать его ради двух — оставить внизу дыру, что и получалось. */
PickerScreen.snug #picker-tagline { margin-bottom: 1; }
PickerScreen.snug .mode-card { margin-bottom: 0; }
PickerScreen.snug #picker-hint { margin-top: 0; }

PickerScreen.short .mode-card { height: 5; }

PickerScreen.tiny #picker-logo { display: none; }

PickerScreen.micro #picker-tagline { display: none; }
PickerScreen.micro .mode-card { height: 3; padding: 0 2; }

/* --- развёрнутые панели РАЗБОРА: у каждой свой слой --------------------- */
/* Слои живут в тех же панелях и включаются только на разворот: рисование
   зависит от режима, а не от размера, поэтому переключает их код. */

#numbers-why, #machine-matrix, #machine-foot, #detail-graph,
#machine-filter-row {
    display: none;
}

#numbers-why { height: 1fr; scrollbar-size-vertical: 1; }
#numbers-head { height: auto; }
#numbers-chain { height: auto; }
#numbers-res { height: auto; }

/* auto, а не 1fr: с 1fr таблица распирала себя на весь экран, и занятость
   портов уезжала в самый низ — между матрицей и полосами зияло полтысячи
   пустых строк. Блоки должны идти подряд, пустота — оставаться под ними. */
#machine-matrix { height: auto; max-height: 60%; background: transparent; }
#machine-matrix > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}
#machine-matrix > .datatable--cursor { background: $primary 30%; }
#machine-matrix > .datatable--hover { background: $nex-raised; }
#machine-foot { height: auto; padding-top: 1; }

#machine-filter-row { height: 1; width: 100%; margin-bottom: 1; }
#machine-filter-label { width: 8; height: 1; color: $nex-faint; }
#machine-filter {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}
#machine-filter > .input--placeholder { color: $nex-faint; }

#detail-graph { height: 1fr; width: 100%; }
#detail-preds, #detail-succs { width: 1fr; height: 100%; }

/* Ссылка на операцию: подчёркнута наведением, как ссылка и должна быть.
   Отдельного цвета не получает — цвет в этом интерфейсе уже занят
   операциями и режимом, и пятый смысл он бы не выдержал. */
.instr-link { height: 1; width: 100%; }
.instr-link:hover { background: $nex-raised; }

/* --- журнал запусков (развёрнутый ВЫВОД КОМАНД) ------------------------- */

ConsoleJournal { display: none; height: 1fr; width: 100%; }

/* Левая колонка: история сессии. 32 — по строке коммита
    «▸ #12 14:02 к /code run», а не «на глаз побольше». */
#journal-side {
    width: 32;
    height: 100%;
    border-right: solid $nex-line 35%;
    padding-right: 1;
}

#journal-cmds-head, #journal-runs-head { height: 1; width: 100%; }
#journal-runs-head { margin-top: 1; }

/* Каталог занимает столько, сколько в нём есть (но не больше половины
   колонки), а запуски забирают остаток. С фиксированным 1fr каталог держал
   половину даже когда в нём после фильтра три строки, и ЗАПУСКИ висели
   посреди пустоты. */
#journal-cmds { height: auto; max-height: 55%; scrollbar-size-vertical: 1; }
#journal-list { height: 1fr; scrollbar-size-vertical: 1; }

.cmd-item { height: 1; width: 100%; }
.cmd-item:hover { background: $nex-raised; }

#journal-right { width: 1fr; height: 100%; }

#journal-out {
    width: 100%;
    height: 1fr;
    background: transparent;
    padding-left: 2;
    scrollbar-size-vertical: 1;
}

/* Вкладки потока: отчёты команд или живые события. Одна строка, как
   вкладки расписания — тот же язык, что во всём интерфейсе. */
#feed-tabs { height: 1; width: 100%; margin-bottom: 1; }

#events-out {
    display: none;
    width: 100%;
    height: 1fr;
    background: transparent;
    padding-left: 2;
    scrollbar-size-vertical: 1;
}

/* Строка ввода журнала — то же терминальное приглашение, что в доке:
    один ряд, волосок сверху, без подложки и без рамки. Вторая версия этой
    строки была «чипом с круглой рамкой» — единственным обведённым полем
    во всём интерфейсе, и журнал выглядел формой внутри панели. */
#journal-field {
    height: 2;
    width: 100%;
    margin: 0;
    padding: 0 1;
    background: transparent;
    border: none;
    border-top: solid $nex-line 30%;
}

#journal-field:focus-within {
    background: transparent;
    border: none;
    border-top: solid $primary 55%;
}

#journal-mark { width: 2; height: 1; content-align: left middle; }

/* Правая часть строки журнала — постоянная подсказка. Раньше здесь было
   пусто, а подсказки жили в placeholder и пропадали при первом же символе.
   Имя `journal-hint`, а НЕ `journal-side`: последнее уже занято левой
   колонкой каталога (шириной 32). Совпадение id рушило раскладку молча —
   правило `width: auto` прилетало и в колонку, вывод схлопывался до двух
   символов, и развёрнутый журнал показывал пустой экран. */
#journal-hint {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $nex-faint;
    content-align: right middle;
}

#journal-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}

/* Подсказка — приглашение к набору, а не пролистываемый вывод. */
#journal-input > .input--placeholder {
    color: $nex-dim;
    text-style: none;
}

/* Запись истории — две строки, как коммит в git log: кто/когда и что
    за состояние. height auto, а не 1: строка состояния вторая по счёту. */
.run-item { height: auto; width: 100%; }
.run-item:hover { background: $nex-raised; }
.run-item.on { background: $primary 18%; }

/* Ряд мостика: куда отправить выбранный прогон. Общий виджет — он живёт
    и в развёрнутом журнале (#run-actions), и в свёрнутой вкладке ОТЧЁТА
    КОДА (#drawer-bridge): перенос не должен требовать разворота. */
BridgeRow {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}

/* Подпись ряда: без неё кнопки — просто кнопки, и не видно, что все они
    действуют на ВЫБРАННЫЙ в истории прогон. */
.bridge-label {
    width: auto;
    height: 1;
    padding: 0 1 0 0;
    color: $nex-faint;
}

/* --- развёрнутые панели ЯДРА -------------------------------------------- */

#names-wide, #mem-wide, #prog-wide { display: none; }

#names-wide, #prog-wide { height: 1fr; scrollbar-size-vertical: 1; }

#mem-wide { height: 1fr; }
#mem-head { height: auto; }
#mem-foot { height: auto; }

#mem-map {
    height: auto;
    width: 100%;
    grid-gutter: 0 2;
    padding: 1 0;
}

.mem-cell { height: 1; width: 9; }
.mem-cell.wrote { background: $nex-raised; }
.mem-cell:hover { background: $nex-raised; }

/* Свёрнутая ПАМЯТЬ — та же карта, что в развороте, только компактнее:
    те же клики и маркеры записей store. */
#mem-mini { height: auto; width: 100%; }
#mem-mini-foot { height: auto; width: 100%; }
.mem-cell.mini { width: 8; }

/* ПРОГРАММА — по операции на строку: клик подсвечивает строку ЛЕНТЫ,
    которая эту операцию породила (обратная половина связки листа). */
#program { height: 1fr; width: 100%; scrollbar-size-vertical: 1; }

.prog-item { height: 1; width: 100%; padding: 0 1; }
.prog-item:hover { background: $nex-raised; }
.prog-item.hot {
    background: $primary 25%;
    color: $nex-title;
    text-style: bold;
}

/* --- всплывающая строка вопроса ----------------------------------------- */
/* Снизу, а не сбоку: колонка отбирала треть ширины у того, ради чего панель
   и разворачивают. Строка лежит поверх нижнего края и растёт вверх ответом. */

PanelPrompt {
    dock: bottom;
    width: 100%;
    height: auto;
    max-height: 60%;
    background: $nex-panel;
    border: round $primary;
    padding: 0 1;
    margin: 0 1 0 1;
}

#pp-header { height: 1; width: 100%; margin-bottom: 1; }
#pp-title { width: 1fr; height: 1; }

/* Крестик — не кнопка с рамкой (это спорило бы с полями ввода вокруг), а
   строка «✕ Esc», которая выделяется только под курсором: так же ведут себя
   чипы. Ширина под подпись, а не только символ: клавишу закрытия должно
   быть видно текстом, а не только всплывающей подсказкой по наведению. */
#pp-close {
    width: 7;
    height: 1;
    content-align: right middle;
    color: $nex-faint;
}
#pp-close:hover {
    color: $nex-title;
    background: $nex-raised;
    text-style: bold;
}

#pp-answer {
    height: auto;
    max-height: 14;
    scrollbar-size-vertical: 1;
}

.pp-line { height: auto; width: 100%; margin-bottom: 1; }

#pp-chips { height: auto; width: 100%; grid-gutter: 0 1; }

.prompt-chip {
    width: 1fr;
    height: 1;
    background: transparent;
    color: $nex-dim;
    margin-right: 1;
}

#pp-field { height: 1; width: 100%; }
#pp-mark { width: 2; height: 1; }

#pp-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}

#pp-input > .input--placeholder { color: $nex-faint; }

/* --- развёрнутые панели АГЕНТА ------------------------------------------ */

#seen-wide, #trace-wide { display: none; height: 1fr; scrollbar-size-vertical: 1; }

#scen-wide { display: none; height: 1fr; width: 100%; }
#scen-head { height: auto; }

#scen-filter-row { height: 1; width: 100%; margin-bottom: 1; }
#scen-filter-label { width: 8; height: 1; color: $nex-faint; }
#scen-filter {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
    color: $nex-title;
}
#scen-filter > .input--placeholder { color: $nex-faint; }

#scen-table { height: auto; max-height: 60%; background: transparent; }
#scen-table > .datatable--header {
    background: transparent;
    color: $nex-dim;
    text-style: none;
}
#scen-table > .datatable--cursor { background: $primary 30%; }
#scen-table > .datatable--hover { background: $nex-raised; }
#scen-foot { height: auto; padding-top: 1; }

#kern-wide { display: none; height: 1fr; scrollbar-size-vertical: 1; }
