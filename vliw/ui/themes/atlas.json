{
  "name": "atlas",
  "description": "NEX CLI: синий NEX, голубой Эльбрус. Три панели на одной палитре. Операции разного цвета — это данные.",

  "roles": {
    "text":         { "color": 254 },
    "dim":          { "color": 245 },
    "faint":        { "color": 239 },

    "accent":       { "color": 39,  "attrs": ["bold"] },
    "accent_soft":  { "color": 75 },
    "accent2":      { "color": 81,  "attrs": ["bold"] },
    "accent2_soft": { "color": 117 },

    "success":      { "color": 80 },
    "warning":      { "color": 221 },
    "error":        { "color": 203, "attrs": ["bold"] },

    "banner":       { "color": 39,  "attrs": ["bold"] },
    "banner_alt":   { "color": 159, "attrs": ["bold"] },
    "mountain":     { "color": 81 },
    "snow":         { "color": 255, "attrs": ["bold"] },

    "border":       { "color": 67 },
    "border_hi":    { "color": 39 },
    "title":        { "color": 255, "attrs": ["bold"] },
    "prompt":       { "color": 39,  "attrs": ["bold"] },
    "selection":    { "color": 39,  "attrs": ["reverse"] },

    "sidebar_head": { "color": 81,  "attrs": ["bold"] },
    "sidebar_key":  { "color": 245 },
    "sidebar_val":  { "color": 254 },

    "crit":         { "color": 159, "attrs": ["bold", "underline"] },
    "diverge":      { "color": 203, "attrs": ["bold"] },

    "work":         { "color": 39,  "attrs": ["bold"] },
    "work_soft":    { "color": 75 },
    "lab":          { "color": 81,  "attrs": ["bold"] },
    "lab_soft":     { "color": 117 },
    "mind":         { "color": 111, "attrs": ["bold"] },
    "mind_soft":    { "color": 153 },
    "hud":          { "color": 245 },
    "dock":         { "color": 254 }
  },

  "ops": {
    "DIV":   { "color": 213, "attrs": ["bold"] },
    "MUL":   { "color": 51,  "attrs": ["bold"] },
    "ADD":   { "color": 80 },
    "SUB":   { "color": 80 },
    "LOAD":  { "color": 221 },
    "STORE": { "color": 221 },
    "AND":   { "color": 109 },
    "SHL":   { "color": 109 }
  }
}
